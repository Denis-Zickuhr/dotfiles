#!/bin/bash

SCRIPT_CONTENT=$(cat <<'EOF'
    VERSION="1.1.0"
    GREEN="\033[0;32m"; YELLOW="\033[1;33m"; CYAN="\033[0;36m"; RED="\033[0;31m"; GRAY="\033[90m"; NC="\033[0m"

    show_help() {
        echo -e "${CYAN}git pinch v$VERSION${NC}"
        echo ""
        echo "Opens, edits, reverts, or amends files changed since the fork point."
        echo ""
        echo -e "${YELLOW}Usage:${NC}"
        echo "  git pinch [options]"
        echo ""
        echo -e "${YELLOW}Modes:${NC}"
        echo "  (default)            Open changed files in editor"
        echo "  -a, --amend          Edit mode: open files, then amend last commit with changes"
        echo "  -r, --revert [file]  Revert files to upstream state (all if no file specified)"
        echo "  -k, --keep           Soft-reset commits back to merge base"
        echo ""
        echo -e "${YELLOW}Options:${NC}"
        echo "  -e, --editor <ed>    Use specific editor (overrides auto-detection)"
        echo "  -u, --upstream <br>  Upstream branch to diff against (default: auto-detect)"
        echo "  -s, --select         Interactively select which files to open/revert/amend"
        echo "  -h, --help           Show this help message"
        echo "  -v, --version        Show version"
        echo ""
        echo -e "${YELLOW}Editor resolution:${NC}"
        echo "  git config core.editor > \$EDITOR > code > vim"
        echo ""
        echo -e "${YELLOW}Examples:${NC}"
        echo "  git pinch                    # open all changed files"
        echo "  git pinch -a                 # edit files, amend into last commit"
        echo "  git pinch -r                 # revert all files to upstream state"
        echo "  git pinch -r src/file.ts     # revert specific file"
        echo "  git pinch -s -a              # select files, edit, amend"
    }

    if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
        echo -e "${RED}Error: Not in a git repository.${NC}"; exit 1
    fi

    # Resolve editor
    resolve_editor() {
        local ed=""
        ed=$(git config core.editor 2>/dev/null | sed 's/ --wait//g')
        ed="${ed:-${EDITOR:-}}"
        if [ -z "$ed" ]; then
            if command -v code > /dev/null 2>&1; then
                ed="code --wait"
            else
                ed="vim"
            fi
        fi
        echo "$ed"
    }

    # Get merge base
    get_merge_base() {
        local upstream=$1
        local base=$(git merge-base "origin/$upstream" HEAD 2>/dev/null)
        if [ -z "$base" ]; then
            echo -e "${RED}Error: Could not find merge base for origin/$upstream.${NC}" >&2
            exit 1
        fi
        echo "$base"
    }

    # Get changed files
    get_changed_files() {
        local merge_base=$1
        git diff --name-only "$merge_base..HEAD" 2>/dev/null | grep -vE "^(vendor/|node_modules/|public/storage/|composer.lock|package-lock.json)"
    }

    # Interactive file selector
    select_files() {
        local all_files=$1
        local selected=()
        local i=1

        echo -e "${CYAN}Select files (space-separated numbers, or 'a' for all):${NC}"
        echo ""
        while IFS= read -r f; do
            echo -e "  ${GRAY}$i)${NC} $f"
            i=$((i+1))
        done <<< "$all_files"
        echo ""

        local choice
        read -p "> " choice < /dev/tty

        if [[ "$choice" =~ ^[aA]$ ]]; then
            echo "$all_files"
            return
        fi

        local file_array=()
        while IFS= read -r f; do
            file_array+=("$f")
        done <<< "$all_files"

        local result=""
        for num in $choice; do
            if [[ "$num" =~ ^[0-9]+$ ]] && [ "$num" -ge 1 ] && [ "$num" -le "${#file_array[@]}" ]; then
                if [ -n "$result" ]; then
                    result="$result"$'\n'"${file_array[$((num-1))]}"
                else
                    result="${file_array[$((num-1))]}"
                fi
            fi
        done

        if [ -z "$result" ]; then
            echo -e "${RED}No valid files selected.${NC}" >&2
            exit 1
        fi
        echo "$result"
    }

    # --- Mode: Default (open files) ---
    mode_open() {
        local files=$1 editor=$2
        echo -e "${CYAN}Opening ${GRAY}$(echo "$files" | wc -l | xargs)${CYAN} changed files...${NC}"
        echo "$files" | xargs -r -o $editor
    }

    # --- Mode: Amend ---
    mode_amend() {
        local files=$1 editor=$2 merge_base=$3

        local commit_count=$(git rev-list --count "$merge_base..HEAD" 2>/dev/null)
        if [ "$commit_count" -eq 0 ]; then
            echo -e "${RED}Error: No commits to amend (HEAD is at merge base).${NC}"
            exit 1
        fi

        local last_msg=$(git log -1 --pretty=%B)
        echo -e "${CYAN}Amend mode:${NC} edit files, save, close editor → changes amend into last commit."
        echo -e "${GRAY}Last commit: ${last_msg}${NC}"
        echo ""

        # Open editor and wait
        echo "$files" | xargs -r -o $editor

        # Check what changed
        local changed=$(git status --porcelain 2>/dev/null | awk '{print $2}')
        if [ -z "$changed" ]; then
            echo -e "${YELLOW}No modifications detected. Nothing to amend.${NC}"
            exit 0
        fi

        echo ""
        echo -e "${CYAN}Modified files:${NC}"
        echo "$changed" | while IFS= read -r f; do
            echo -e "  ${GREEN}+${NC} $f"
        done

        echo ""
        printf "Amend these into the last commit? [Y/n] "
        read -r answer < /dev/tty

        case "$answer" in
            [nN][oO]|[nN])
                echo -e "${YELLOW}Aborted. Files are modified but not committed.${NC}"
                exit 0
                ;;
            *)
                git add $changed
                git commit --amend --no-edit > /dev/null 2>&1
                echo -e "${GREEN}✓ Last commit amended with your changes.${NC}"
                ;;
        esac
    }

    # --- Mode: Revert ---
    mode_revert() {
        local files=$1 merge_base=$2

        local count=$(echo "$files" | wc -l | xargs)
        echo -e "${YELLOW}This will revert $count file(s) to their state at origin/$UPSTREAM:${NC}"
        echo ""
        echo "$files" | while IFS= read -r f; do
            echo -e "  ${RED}↩${NC} $f"
        done

        echo ""
        printf "Continue? [y/N] "
        read -r answer < /dev/tty

        case "$answer" in
            [yY][eE][sS]|[yY])
                echo "$files" | while IFS= read -r f; do
                    git checkout "$merge_base" -- "$f" 2>/dev/null
                    if [ $? -eq 0 ]; then
                        echo -e "  ${GREEN}✓${NC} $f"
                    else
                        echo -e "  ${RED}✗${NC} $f (not found at merge base)"
                    fi
                done
                echo ""
                echo -e "${GREEN}Files reverted. Changes are staged — commit when ready.${NC}"
                ;;
            *)
                echo -e "${YELLOW}Aborted. No files were reverted.${NC}"
                exit 0
                ;;
        esac
    }

    # --- Mode: Keep (soft reset) ---
    mode_keep() {
        local merge_base=$1
        local short_base=$(git rev-parse --short "$merge_base")
        local commit_count=$(git rev-list --count "$merge_base..HEAD" 2>/dev/null)

        echo ""
        echo -e "${YELLOW}Warning: This will soft-reset $commit_count commit(s) back to ${short_base}.${NC}"
        echo -e "${GRAY}Your changes will remain staged (ready to re-commit).${NC}"
        printf "Continue? [y/N] "
        read -r answer < /dev/tty

        case "$answer" in
            [yY][eE][sS]|[yY])
                git reset --soft "$merge_base" > /dev/null 2>&1
                echo -e "${GREEN}✓ Commits squashed back to merge base. Changes are staged.${NC}"
                ;;
            *)
                echo -e "${YELLOW}Aborted.${NC}"
                exit 0
                ;;
        esac
    }

    # --- Parse args ---
    default_upstream=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed "s|origin/||")
    UPSTREAM="${default_upstream:-main}"
    EDITOR_OVERRIDE=""
    MODE="open"
    SELECT=false
    REVERT_FILE=""

    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)      show_help; exit 0 ;;
            -v|--version)   echo "git pinch v$VERSION"; exit 0 ;;
            -e|--editor)    EDITOR_OVERRIDE="$2"; shift ;;
            -u|--upstream)  UPSTREAM="$2"; shift ;;
            -a|--amend)     MODE="amend" ;;
            -r|--revert)
                MODE="revert"
                # Check if next arg is a file (not a flag)
                if [ -n "$2" ] && [[ "$2" != -* ]]; then
                    REVERT_FILE="$2"; shift
                fi
                ;;
            -k|--keep)      MODE="keep" ;;
            -s|--select)    SELECT=true ;;
            *)
                echo -e "${RED}Unknown option: $1${NC}"
                show_help; exit 1 ;;
        esac
        shift
    done

    # Resolve editor (can be overridden)
    if [ -n "$EDITOR_OVERRIDE" ]; then
        FINAL_EDITOR="$EDITOR_OVERRIDE"
    else
        FINAL_EDITOR=$(resolve_editor)
    fi

    # Get merge base and files
    merge_base=$(get_merge_base "$UPSTREAM")
    files=$(get_changed_files "$merge_base")

    if [ -z "$files" ]; then
        echo -e "${YELLOW}No changes detected relative to origin/$UPSTREAM.${NC}"
        exit 0
    fi

    # If reverting a specific file, validate it exists in the diff
    if [ "$MODE" = "revert" ] && [ -n "$REVERT_FILE" ]; then
        if ! echo "$files" | grep -qx "$REVERT_FILE"; then
            echo -e "${RED}Error: '$REVERT_FILE' is not in the list of changed files.${NC}"
            echo -e "${GRAY}Changed files:${NC}"
            echo "$files" | while IFS= read -r f; do echo "  $f"; done
            exit 1
        fi
        files="$REVERT_FILE"
    fi

    # Interactive selection (applies to open, amend, revert)
    if [ "$SELECT" = true ] && [ "$MODE" != "keep" ]; then
        files=$(select_files "$files")
    fi

    # Execute mode
    case "$MODE" in
        open)
            mode_open "$files" "$FINAL_EDITOR"
            ;;
        amend)
            mode_amend "$files" "$FINAL_EDITOR" "$merge_base"
            ;;
        revert)
            mode_revert "$files" "$merge_base"
            ;;
        keep)
            mode_open "$files" "$FINAL_EDITOR"
            mode_keep "$merge_base"
            ;;
    esac
EOF
)

ESCAPED_CODE=$(echo "$SCRIPT_CONTENT" | sed "s/'/'\\\\''/g")

git config --global alias.pinch "!f() {
    bash -c '$ESCAPED_CODE' -- \"\$@\"
}; f"
