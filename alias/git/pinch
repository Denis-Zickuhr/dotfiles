#!/bin/bash

SCRIPT_CONTENT=$(cat <<'EOF'
    VERSION="1.0.0"
    GREEN="\033[0;32m"; YELLOW="\033[1;33m"; CYAN="\033[0;36m"; RED="\033[0;31m"; NC="\033[0m"

    show_help() {
        echo -e "${CYAN}git pinch v$VERSION${NC}"
        echo ""
        echo "Opens all files changed since the fork point of the current branch from upstream."
        echo ""
        echo -e "${YELLOW}Usage:${NC}"
        echo "  git pinch [options]"
        echo ""
        echo -e "${YELLOW}Options:${NC}"
        echo "  -e, --editor <editor>    Use the specified editor (overrides auto-detection)"
        echo "  -k, --keep               Soft-reset all commits back to the merge base after opening"
        echo "  -u, --upstream <branch>  Upstream branch to diff against (default: origin/HEAD or main)"
        echo "  -h, --help               Show this help message"
        echo "  -v, --version            Show version"
        echo ""
        echo -e "${YELLOW}Editor resolution order:${NC}"
        echo "  1. git config core.editor"
        echo "  2. \$EDITOR environment variable"
        echo "  3. code"
        echo "  4. vim"
    }

    if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
        echo -e "${RED}Error: Not in a git repository.${NC}"; exit 1
    fi

    # Resolve editor
    git_editor=$(git config core.editor 2>/dev/null | sed 's/ --wait//g')
    editor="${git_editor:-${EDITOR:-}}"
    if [ -z "$editor" ]; then
        if command -v code > /dev/null 2>&1; then
            editor="code --wait"
        else
            editor="vim"
        fi
    fi

    default_upstream=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed "s|origin/||")
    upstream="${default_upstream:-main}"

    keep=false

    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)     show_help; exit 0 ;;
            -v|--version)  echo "git pinch v$VERSION"; exit 0 ;;
            -e|--editor)   editor="$2"; shift ;;
            -k|--keep)     keep=true ;;
            -u|--upstream) upstream="$2"; shift ;;
            *) break ;;
        esac
        shift
    done

    merge_base=$(git merge-base "origin/$upstream" HEAD 2>/dev/null)

    if [ -z "$merge_base" ]; then
        echo -e "${RED}Error: Could not find merge base for origin/$upstream.${NC}"
        exit 1
    fi

    files=$(git diff --name-only "$merge_base..HEAD" 2>/dev/null | grep -vE "^(vendor/|node_modules/|public/storage/|composer.lock|package-lock.json)")

    if [ -z "$files" ]; then
        echo -e "${YELLOW}No changes detected relative to origin/$upstream.${NC}"
        exit 0
    fi

    echo -e "${CYAN}Pinching files changed since diverged from origin/$upstream...${NC}"
    echo "$files" | xargs -r -o $editor

    if [ "$keep" = true ]; then
        short_base=$(git rev-parse --short "$merge_base")
        echo ""
        echo -e "${YELLOW}Warning: This will soft-reset all commits since ${short_base} (merge base with origin/$upstream).${NC}"
        printf "Continue? [y/N] "
        read -r answer
        case "$answer" in
            [yY][eE][sS]|[yY])
                git reset --soft "$merge_base" > /dev/null 2>&1
                echo -e "${GREEN}Done. Commits squashed back to merge base.${NC}"
                ;;
            *)
                echo -e "${YELLOW}Aborted. No changes were made.${NC}"
                exit 0
                ;;
        esac
    fi
EOF
)

ESCAPED_CODE=$(echo "$SCRIPT_CONTENT" | sed "s/'/'\\\\''/g")

git config --global alias.pinch "!f() {
    bash -c '$ESCAPED_CODE' -- \"\$@\"
}; f"
