#!/bin/bash

SCRIPT_CONTENT=$(cat <<'EOF'
VERSION="1.0.0"
GREEN="\033[0;32m"; YELLOW="\033[1;33m"; CYAN="\033[0;36m"; RED="\033[0;31m"; NC="\033[0m"

show_help() {
    echo -e "${CYAN}git copen v${VERSION}${NC}"
    echo ""
    echo "Open modified files in the configured editor."
    echo ""
    echo -e "${YELLOW}Usage:${NC}"
    echo "  git copen [options]"
    echo ""
    echo -e "${YELLOW}Options:${NC}"
    echo "  -e, --editor <editor>  Use specified editor instead of configured one"
    echo "  -h, --help             Show this help message"
    echo "  -v, --version          Show version"
    echo ""
    echo -e "${YELLOW}Editor resolution order:${NC}"
    echo "  1. git config core.editor"
    echo "  2. \$EDITOR environment variable"
    echo "  3. code (VS Code)"
    echo "  4. vim"
    echo ""
    echo -e "${YELLOW}Examples:${NC}"
    echo "  git copen                  # Open all modified files"
    echo "  git copen -e vim           # Open with vim"
}

resolve_editor() {
    local editor

    editor=$(git config core.editor 2>/dev/null)
    # Strip common wait flags used by GUI editors (e.g. "code --wait")
    editor=${editor% --wait}
    editor=${editor% -w}
    # Keep only the executable name/path, strip any remaining flags
    editor=${editor%% *}

    if [ -z "$editor" ] && [ -n "$EDITOR" ]; then
        editor="$EDITOR"
    fi

    if [ -z "$editor" ] && command -v code > /dev/null 2>&1; then
        editor="code"
    fi

    if [ -z "$editor" ]; then
        editor="vim"
    fi

    echo "$editor"
}

# Parse options
custom_editor=""
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)    show_help; exit 0 ;;
        -v|--version) echo "git copen v$VERSION"; exit 0 ;;
        -e|--editor)
            if [ -z "$2" ]; then
                echo -e "${RED}Error: --editor requires an argument.${NC}" >&2
                exit 1
            fi
            custom_editor="$2"
            shift
            ;;
        *) echo -e "${RED}Error: Unknown option '$1'. Use --help for usage.${NC}" >&2; exit 1 ;;
    esac
    shift
done

# Validate git repo
if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    echo -e "${RED}Error: Not in a git repository.${NC}" >&2
    exit 1
fi

# Resolve editor
if [ -n "$custom_editor" ]; then
    tool="$custom_editor"
else
    tool=$(resolve_editor)
fi

# Collect modified files using NUL-separated output to handle filenames with spaces.
#
# git status --porcelain=v1 -z emits NUL-terminated records:
#   "XY<SP>filepath\0"          for normal entries
#   "XY<SP>new_path\0orig_path\0"  for renamed/copied entries (R/C in index column)
#
# We always want the *new* path (filepath), and must consume (discard) the
# extra orig_path token for R/C entries so the loop stays in sync.
files=()
while IFS= read -r -d $'\0' entry; do
    xy="${entry:0:2}"
    filepath="${entry:3}"
    x="${xy:0:1}"
    y="${xy:1:1}"

    # Consume and discard the original path token emitted for renames/copies
    if [[ "$x" =~ [RC] ]]; then
        IFS= read -r -d $'\0' _origpath
    fi

    # Skip untracked (??) and ignored (!!) entries
    [ "$xy" = "??" ] && continue
    [ "$xy" = "!!" ] && continue

    # Skip purely deleted files (nothing to open)
    if [ "$x" = "D" ] && [[ ! "$y" =~ [MAC] ]]; then
        continue
    fi
    if [ "$y" = "D" ] && [[ ! "$x" =~ [MARC] ]]; then
        continue
    fi

    # Accept Added, Modified, Renamed, or Copied in either index or worktree column
    if [[ "$x" =~ [AMRC] ]] || [[ "$y" =~ [AMRC] ]]; then
        files+=("$filepath")
    fi
done < <(git status --porcelain=v1 -z)

if [ ${#files[@]} -eq 0 ]; then
    echo -e "${YELLOW}No modified or new files to open.${NC}"
    exit 0
fi

echo -e "${GREEN}Opening ${#files[@]} file(s) with '${tool}'...${NC}"
for f in "${files[@]}"; do
    echo -e "  ${CYAN}${f}${NC}"
done

"$tool" "${files[@]}"
EOF
)

ESCAPED_CODE=$(echo "$SCRIPT_CONTENT" | sed "s/'/'\\\\''/g")

git config --global alias.copen "!f() {
    bash -c '$ESCAPED_CODE' -- \"\$@\"
}; f"
