#!/bin/bash

SCRIPT_CONTENT=$(cat <<'EOF'
    VERSION="1.0.0"
    GREEN="\033[0;32m"; YELLOW="\033[1;33m"; CYAN="\033[0;36m"; RED="\033[0;31m"; NC="\033[0m"

    show_help() {
      echo "Usage: git cbn [options]"
      echo ""
      echo "Generates a commit message automatically from the branch name"
      echo "using conventional commits format."
      echo ""
      echo "Branch format: [PREFIX-]<type>-<description>"
      echo ""
      echo "Options:"
      echo "  -m, --message <msg>    Provide a custom commit message body."
      echo "  -op, --omit-prefix     Omit the prefix (e.g., ticket number) from the commit."
      echo "  -h, --help             Display this help message."
      echo "  -v, --version          Display version information."
      echo ""
      echo "Supported types: feat, fix, chore, docs, style, refactor, perf, test, build, ci, revert"
      echo ""
      echo "Examples:"
      echo "  Branch: JIRA-123-feat-add-login    -> JIRA-123 - feat: add login"
      echo "  Branch: fix-broken-navbar          -> fix: broken navbar"
    }

    error_exit() {
      echo -e "${RED}Error: $1${NC}" >&2
      return 1
    }

    if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
      echo -e "${RED}Error: Not in a git repository.${NC}"
      exit 1
    fi

    CT="feat|fix|chore|docs|style|refactor|perf|test|build|ci|revert"
    CUSTOM_MESSAGE=""
    OMIT_PREFIX=false

    while [ $# -gt 0 ]; do
      case "$1" in
        -h|--help) show_help; exit 0;;
        -v|--version) echo "git cbn v$VERSION"; exit 0;;
        -m|--message)
          if [ -z "$2" ]; then
            error_exit "The '$1' flag requires a message."
            exit 1
          fi
          CUSTOM_MESSAGE="$2"; shift; shift;;
        -op|--omit-prefix) OMIT_PREFIX=true; shift;;
        *) error_exit "Unknown option: $1"; exit 1;;
      esac
    done

    BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)
    if [ -z "$BRANCH_NAME" ]; then
      error_exit "Could not determine branch name."
      exit 1
    fi

    COMMIT_TYPE=$(echo "$BRANCH_NAME" | grep -oE "(^|[-/])(${CT})([-/])" | grep -oE "${CT}" | head -n 1)
    if [ -z "$COMMIT_TYPE" ]; then
      error_exit "No conventional commit type found in branch '${BRANCH_NAME}'."
      exit 1
    fi

    case "$BRANCH_NAME" in
      *-${COMMIT_TYPE}-*)
        PREFIX=$(echo "$BRANCH_NAME" | sed "s/-${COMMIT_TYPE}-.*//")
        DESCRIPTION=$(echo "$BRANCH_NAME" | sed "s/.*-${COMMIT_TYPE}-//")
        ;;
      */${COMMIT_TYPE}-*)
        PREFIX=$(echo "$BRANCH_NAME" | sed "s/\/${COMMIT_TYPE}-.*//")
        DESCRIPTION=$(echo "$BRANCH_NAME" | sed "s/.*\/${COMMIT_TYPE}-//")
        ;;
      ${COMMIT_TYPE}-*)
        PREFIX=""
        DESCRIPTION=$(echo "$BRANCH_NAME" | sed "s/^${COMMIT_TYPE}-//")
        ;;
      *)
        error_exit "Branch format invalid. Use '[PREFIX-]<type>-<desc>' or '<type>-<desc>'."
        exit 1
        ;;
    esac

    DESCRIPTION=$(echo "$DESCRIPTION" | sed "s/[-_]/ /g")

    if [ -n "$CUSTOM_MESSAGE" ]; then
      MSG_BODY="$CUSTOM_MESSAGE"
    elif [ -z "$DESCRIPTION" ]; then
      error_exit "Branch name must include a description after the type."
      exit 1
    else
      MSG_BODY="$DESCRIPTION"
    fi

    COMMIT_PREFIX=""
    if [ -n "$PREFIX" ] && [ "$OMIT_PREFIX" = false ]; then
      COMMIT_PREFIX="${PREFIX} - "
    fi

    COMMIT_MESSAGE="${COMMIT_PREFIX}${COMMIT_TYPE}: ${MSG_BODY}"
    echo -e "${GREEN}Running:${NC} git commit -m \"${CYAN}${COMMIT_MESSAGE}${NC}\""
    git commit -m "$COMMIT_MESSAGE"
EOF
)

ESCAPED_CODE=$(echo "$SCRIPT_CONTENT" | sed "s/'/'\\\\''/g")

git config --global alias.cbn "!f() {
    bash -c '$ESCAPED_CODE' -- \"\$@\"
}; f"
