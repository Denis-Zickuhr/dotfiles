#!/bin/bash

SCRIPT_CONTENT=$(cat <<'EOF'
    VERSION="1.0.0"
    GREEN="\033[0;32m"; YELLOW="\033[1;33m"; CYAN="\033[0;36m"; RED="\033[0;31m"; NC="\033[0m"

    show_help() {
        echo -e "${CYAN}git rebirth${NC} - Reset current branch to match remote origin"
        echo ""
        echo -e "${YELLOW}Usage:${NC} git rebirth [options]"
        echo ""
        echo -e "${YELLOW}Options:${NC}"
        echo "  -s, --safe       Stash changes before resetting (auto-restores after)"
        echo "  -h, --help       Show this help message"
        echo "  -v, --version    Show version"
        echo ""
        echo -e "${YELLOW}Examples:${NC}"
        echo "  git rebirth          Reset branch to origin (warns if dirty)"
        echo "  git rebirth --safe   Stash changes, reset, then restore changes"
    }

    SAFE_MODE=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help) show_help; exit 0;;
            -v|--version) echo "git rebirth v$VERSION"; exit 0;;
            -s|--safe) SAFE_MODE=true; shift;;
            *) echo -e "${RED}Error: Unknown option '$1'${NC}"; show_help; exit 1;;
        esac
    done

    if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
        echo -e "${RED}Error: Not in a git repository.${NC}"; exit 1
    fi

    HEAD_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    STASH_SAVED=false
    IS_DIRTY=false

    if ! git diff --quiet || ! git diff --staged --quiet; then
        IS_DIRTY=true
    fi

    if [ "$SAFE_MODE" = true ]; then
        if [ "$IS_DIRTY" = true ]; then
            echo -e "${CYAN}Stashing changes before reset...${NC}"
            git stash push -m "rebirth: auto-stash before reset"
            STASH_SAVED=true
        fi
    else
        if [ "$IS_DIRTY" = true ]; then
            echo -e "${YELLOW}Warning: You have uncommitted changes that will be lost.${NC}"
            echo -e "${YELLOW}Use --safe to stash them automatically.${NC}"
            echo ""
            printf "Proceed with hard reset? [y/N] "
            read -r CONFIRM
            if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
                echo -e "${CYAN}Aborted.${NC}"
                exit 0
            fi
        fi
    fi

    echo -e "${CYAN}Fetching from origin...${NC}"
    if ! git fetch origin; then
        echo -e "${RED}Error: Failed to fetch from origin. Reset aborted.${NC}"
        if [ "$STASH_SAVED" = true ]; then
            echo -e "${YELLOW}Restoring stashed changes...${NC}"
            git stash pop
        fi
        exit 1
    fi

    echo -e "${CYAN}Resetting branch to origin/${HEAD_BRANCH}...${NC}"
    if ! git reset --hard "origin/${HEAD_BRANCH}"; then
        echo -e "${RED}Error: Failed to reset to origin/${HEAD_BRANCH}.${NC}"
        if [ "$STASH_SAVED" = true ]; then
            echo -e "${YELLOW}Restoring stashed changes...${NC}"
            git stash pop
        fi
        exit 1
    fi

    if [ "$STASH_SAVED" = true ]; then
        echo -e "${CYAN}Restoring stashed changes...${NC}"
        if ! git stash pop; then
            echo -e "${RED}Error: Failed to restore stashed changes (likely conflicts).${NC}"
            echo -e "${YELLOW}Your changes are still in the stash. Resolve manually with:${NC}"
            echo -e "  git stash show -p"
            echo -e "  git stash drop  ${YELLOW}(after resolving)${NC}"
            exit 1
        fi
    fi

    echo -e "${GREEN}Branch '${HEAD_BRANCH}' successfully reset to origin/${HEAD_BRANCH}.${NC}"
EOF
)

ESCAPED_CODE=$(echo "$SCRIPT_CONTENT" | sed "s/'/'\\\\''/g")

git config --global alias.rebirth "!f() {
    bash -c '$ESCAPED_CODE' -- \"\$@\"
}; f"
