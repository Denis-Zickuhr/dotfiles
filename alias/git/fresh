#!/bin/bash

SCRIPT_CONTENT=$(cat <<'EOF'
    VERSION="1.0.0"
    GREEN="\033[0;32m"; YELLOW="\033[1;33m"; CYAN="\033[0;36m"; RED="\033[0;31m"; NC="\033[0m"

    show_help() {
        echo -e "${CYAN}git fresh${NC} — Switch to main branch, fetch and pull latest changes."
        echo ""
        echo -e "${YELLOW}Usage:${NC} git fresh [options]"
        echo ""
        echo "Options:"
        echo "  -h, --help       Show this help message"
        echo "  -v, --version    Show version"
        echo ""
        echo "Behavior:"
        echo "  - Stashes uncommitted changes before switching (restores after pull)"
        echo "  - Detects main branch from origin/HEAD, falls back to 'main'"
    }

    case "${1:-}" in
        -h|--help) show_help; exit 0;;
        -v|--version) echo "git fresh v$VERSION"; exit 0;;
    esac

    if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
        echo -e "${RED}Error: Not in a git repository.${NC}"; exit 1
    fi

    # Detect main branch
    if git rev-parse --abbrev-ref origin/HEAD > /dev/null 2>&1; then
        MAIN_BRANCH=$(git rev-parse --abbrev-ref origin/HEAD | sed "s|origin/||")
    else
        MAIN_BRANCH="main"
        echo -e "${YELLOW}Warning: origin/HEAD not set, falling back to '${MAIN_BRANCH}'.${NC}"
    fi

    # Stash if dirty
    STASHED=false
    if ! git diff --quiet || ! git diff --cached --quiet; then
        echo -e "${YELLOW}Stashing uncommitted changes...${NC}"
        git stash push -m "git-fresh: auto-stash" > /dev/null 2>&1
        STASHED=true
    fi

    # Checkout, fetch, pull
    git checkout "$MAIN_BRANCH" && git fetch && git pull

    # Pop stash if we stashed
    if [ "$STASHED" = true ]; then
        echo -e "${YELLOW}Restoring stashed changes...${NC}"
        git stash pop > /dev/null 2>&1
    fi

    echo -e "${GREEN}Fresh on '${MAIN_BRANCH}' with latest changes.${NC}"
EOF
)

ESCAPED_CODE=$(echo "$SCRIPT_CONTENT" | sed "s/'/'\\\\''/g")

git config --global alias.fresh "!f() {
    bash -c '$ESCAPED_CODE' -- \"\$@\"
}; f"
