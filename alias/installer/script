#!/bin/bash

SCRIPT_CONTENT=$(cat <<'EOF'
VERSION="1.0.0"
USER="Denis-Zickuhr"
REPO="dotfiles"
BRANCH="main"
BASE_URL="https://raw.githubusercontent.com/$USER/$REPO/$BRANCH"
REGISTRY_URL="$BASE_URL/extensions/registry.json"
EXTENSIONS_URL="$BASE_URL/extensions"
GITHUB_BROWSE="https://github.com/$USER/$REPO/blob/$BRANCH/extensions"

C_RESET='\033[0m'
C_BOLD='\033[1m'
C_DIM='\033[2m'
C_GREEN='\033[32m'
C_RED='\033[31m'
C_YELLOW='\033[33m'
C_CYAN='\033[36m'
C_BLUE='\033[34m'
C_MAGENTA='\033[35m'
C_REVERSE='\033[7m'
C_GRAY='\033[90m'

# --- Helpers ---

check_dependencies() {
    for cmd in curl git; do
        command -v "$cmd" &> /dev/null || {
            echo -e "${C_RED}✗ Error:${C_RESET} $cmd is not installed."
            exit 1
        }
    done
}

is_installed() {
    git config --global --get "alias.$1" > /dev/null 2>&1
}

get_installed_version() {
    local content=$(git config --global --get "alias.$1" 2>/dev/null)
    echo "$content" | grep -oP 'VERSION="[^"]*"' | head -1 | sed 's/VERSION="//;s/"//'
}

show_header() {
    clear
    echo -e "${C_BOLD}${C_CYAN}"
    echo "  ┌─────────────────────────────────────┐"
    echo "  │       GIT EXTENSION MANAGER         │"
    echo "  │              v$VERSION                  │"
    echo "  └─────────────────────────────────────┘"
    echo -e "${C_RESET}"
}

show_help() {
    echo -e "${C_CYAN}git extension v$VERSION${C_RESET}"
    echo ""
    echo "Interactive installer and manager for git aliases."
    echo ""
    echo -e "${C_YELLOW}Usage:${C_RESET}"
    echo "  git extension                Interactive UI"
    echo "  git extension update         Update all installed extensions"
    echo "  git extension list           List installed extensions"
    echo "  git extension remove         Uninstall extensions"
    echo "  git extension self-update    Update the extension manager itself"
    echo "  git extension help           Show this help"
    echo "  git extension version        Show version"
    echo ""
    echo -e "${C_YELLOW}Interactive controls:${C_RESET}"
    echo "  ↑/↓        Navigate"
    echo "  Space       Toggle selection"
    echo "  a           Select all"
    echo "  n           Select none"
    echo "  i           Select only new/outdated"
    echo "  h           Toggle doc link"
    echo "  Enter       Install selected"
    echo "  q           Quit"
    exit 0
}

# --- Registry ---

fetch_registry() {
    echo -ne "  ${C_GRAY}Fetching registry"
    REGISTRY=$(curl -sL "$REGISTRY_URL")

    if [ -z "$REGISTRY" ] || echo "$REGISTRY" | grep -q '"message"'; then
        echo -e "\n  ${C_RED}✗ Failed to fetch registry.${C_RESET}"
        exit 1
    fi
    echo -e "...${C_GREEN}done${C_RESET}"
}

parse_registry() {
    # Parse extensions from JSON (lightweight, no jq dependency)
    NAMES=()
    VERSIONS=()
    DESCRIPTIONS=()
    HAS_PROFILES=()

    local i=0
    while IFS= read -r name; do
        NAMES+=("$name")
        i=$((i+1))
    done < <(echo "$REGISTRY" | grep -oP '"name"\s*:\s*"\K[^"]+')

    i=0
    while IFS= read -r ver; do
        VERSIONS+=("$ver")
        i=$((i+1))
    done < <(echo "$REGISTRY" | grep -oP '"version"\s*:\s*"\K[^"]+')

    i=0
    while IFS= read -r desc; do
        DESCRIPTIONS+=("$desc")
        i=$((i+1))
    done < <(echo "$REGISTRY" | grep -oP '"description"\s*:\s*"\K[^"]+')

    # has_profiles detection
    local block=""
    local idx=0
    while IFS= read -r line; do
        block="$block$line"
        if echo "$line" | grep -q "}"; then
            if echo "$block" | grep -q '"has_profiles"'; then
                HAS_PROFILES[$idx]=true
            else
                HAS_PROFILES[$idx]=false
            fi
            block=""
            idx=$((idx+1))
        fi
    done < <(echo "$REGISTRY" | grep -A5 '"name"')

    if [ ${#NAMES[@]} -eq 0 ]; then
        echo -e "  ${C_RED}✗ No extensions found in registry.${C_RESET}"
        exit 1
    fi
}

resolve_status() {
    INSTALLED_COUNT=0
    NEW_COUNT=0
    UPDATE_COUNT=0

    for i in "${!NAMES[@]}"; do
        local name="${NAMES[$i]}"
        local remote_ver="${VERSIONS[$i]}"

        if is_installed "$name"; then
            local local_ver=$(get_installed_version "$name")
            LOCAL_VERSIONS[$i]="$local_ver"

            if [ -n "$local_ver" ] && [ "$local_ver" != "$remote_ver" ]; then
                STATUS[$i]="update"
                UPDATE_COUNT=$((UPDATE_COUNT + 1))
            else
                STATUS[$i]="installed"
                INSTALLED_COUNT=$((INSTALLED_COUNT + 1))
            fi
        else
            STATUS[$i]="new"
            LOCAL_VERSIONS[$i]=""
            NEW_COUNT=$((NEW_COUNT + 1))
        fi
        echo -ne "."
    done
    echo ""
}

# --- UI ---

get_status_badge() {
    case "$1" in
        installed) echo -e "${C_GREEN}●${C_RESET}" ;;
        new)       echo -e "${C_YELLOW}○${C_RESET}" ;;
        update)    echo -e "${C_MAGENTA}↑${C_RESET}" ;;
    esac
}

render_ui() {
    show_header

    local sel_count=0
    for i in "${!selected[@]}"; do
        [ "${selected[$i]}" -eq 1 ] && sel_count=$((sel_count + 1))
    done

    echo -e "  ${C_GRAY}${#NAMES[@]} extensions │ ${C_GREEN}${INSTALLED_COUNT} installed${C_RESET} ${C_GRAY}│${C_RESET} ${C_YELLOW}${NEW_COUNT} new${C_RESET} ${C_GRAY}│${C_RESET} ${C_MAGENTA}${UPDATE_COUNT} updates${C_RESET} ${C_GRAY}│ ${sel_count} selected${C_RESET}"
    echo -e "  ${C_GRAY}────────────────────────────────────────────────────────────${C_RESET}"
    echo ""

    for i in "${!NAMES[@]}"; do
        local badge=$(get_status_badge "${STATUS[$i]}")
        local check="  "
        [ "${selected[$i]}" -eq 1 ] && check="${C_GREEN}✓${C_RESET} "

        local ver_display=""
        if [ "${STATUS[$i]}" = "update" ]; then
            ver_display=" ${C_GRAY}${LOCAL_VERSIONS[$i]}${C_RESET} → ${C_MAGENTA}${VERSIONS[$i]}${C_RESET}"
        elif [ -n "${LOCAL_VERSIONS[$i]}" ]; then
            ver_display=" ${C_GRAY}v${LOCAL_VERSIONS[$i]}${C_RESET}"
        else
            ver_display=" ${C_GRAY}v${VERSIONS[$i]}${C_RESET}"
        fi

        local desc=" ${C_GRAY}─ ${DESCRIPTIONS[$i]}${C_RESET}"

        if [ "$i" -eq "$cursor" ]; then
            echo -e "  ${C_REVERSE} ${badge} ${check}${NAMES[$i]}${ver_display} ${C_RESET}${desc}"

            if [ "$help_active" = true ]; then
                echo -e "     ${C_GRAY}└─ ${C_CYAN}${GITHUB_BROWSE}/${NAMES[$i]}/README.md${C_RESET}"
            fi
        else
            echo -e "   ${badge} ${check}${NAMES[$i]}${ver_display}${desc}"
        fi
    done

    echo ""
    echo -e "  ${C_GRAY}[↑↓] Navigate  [Space] Toggle  [a] All  [n] None  [i] Smart${C_RESET}"
    echo -e "  ${C_GRAY}[h] Docs  [Enter] Install  [q] Quit${C_RESET}"
}

handle_input() {
    cursor=0
    help_active=false
    selected=()

    # Pre-select new and updates
    for i in "${!NAMES[@]}"; do
        if [ "${STATUS[$i]}" = "new" ] || [ "${STATUS[$i]}" = "update" ]; then
            selected[$i]=1
        else
            selected[$i]=0
        fi
    done

    while true; do
        render_ui
        IFS= read -rsn1 key
        case "$key" in
            $'\x1b')
                read -rsn2 -t 0.1 next
                case "$next" in
                    '[A')
                        ((cursor--))
                        [ "$cursor" -lt 0 ] && cursor=$((${#NAMES[@]} - 1))
                        help_active=false
                        ;;
                    '[B')
                        ((cursor++))
                        [ "$cursor" -ge "${#NAMES[@]}" ] && cursor=0
                        help_active=false
                        ;;
                esac
                ;;
            " ") [ "${selected[$cursor]}" -eq 1 ] && selected[$cursor]=0 || selected[$cursor]=1 ;;
            [aA]) for i in "${!selected[@]}"; do selected[$i]=1; done ;;
            [nN]) for i in "${!selected[@]}"; do selected[$i]=0; done ;;
            [iI])
                for i in "${!NAMES[@]}"; do
                    if [ "${STATUS[$i]}" = "new" ] || [ "${STATUS[$i]}" = "update" ]; then
                        selected[$i]=1
                    else
                        selected[$i]=0
                    fi
                done
                ;;
            [hH]) [ "$help_active" = true ] && help_active=false || help_active=true ;;
            [qQ]) clear; echo -e "  ${C_GRAY}Cancelled.${C_RESET}"; exit 0 ;;
            "") break ;;
        esac
    done
}

# --- Installation ---

configure_ctx_profile() {
    local PROFILES_RAW="$EXTENSIONS_URL/ctx/profiles"

    echo ""
    echo -e "  ${C_BOLD}ctx provider setup${C_RESET}"
    echo -e "  ${C_GRAY}Select a ticket provider:${C_RESET}"
    echo ""

    local profiles=("custom" "github-issues" "jira" "linear")

    local i=1
    for p in "${profiles[@]}"; do
        echo -e "    ${C_CYAN}$i)${C_RESET} $p"
        i=$((i+1))
    done
    echo -e "    ${C_GRAY}s) skip${C_RESET}"
    echo ""

    local choice
    read -p "    Choose: " choice < /dev/tty

    if [[ "$choice" =~ ^[sS]$ ]] || [ -z "$choice" ]; then
        echo -e "  ${C_GRAY}Skipped.${C_RESET}"
        return
    fi

    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#profiles[@]}" ]; then
        local selected_profile="${profiles[$((choice-1))]}"
        local profile_script=$(curl -sL "$PROFILES_RAW/$selected_profile")

        if [ -z "$profile_script" ]; then
            echo -e "  ${C_RED}✗ Failed to fetch profile.${C_RESET}"
            return
        fi

        case "$selected_profile" in
            jira)
                read -p "    Jira domain (e.g., mycompany.atlassian.net): " domain < /dev/tty
                echo "$profile_script" | bash -s -- "$domain"
                ;;
            linear)
                read -p "    Linear workspace slug: " workspace < /dev/tty
                echo "$profile_script" | bash -s -- "$workspace"
                ;;
            custom)
                read -p "    URL prefix (e.g., https://tracker.com/browse/): " prefix < /dev/tty
                echo "$profile_script" | bash -s -- "$prefix"
                ;;
            *)
                echo "$profile_script" | bash
                ;;
        esac
    else
        echo -e "  ${C_RED}Invalid choice.${C_RESET}"
    fi
}

execute_tasks() {
    local count=0
    local success=0
    local failed=0
    local ctx_selected=false

    for i in "${!NAMES[@]}"; do
        [ "${selected[$i]}" -eq 1 ] && count=$((count + 1))
    done

    if [ $count -eq 0 ]; then
        clear
        echo -e "  ${C_YELLOW}Nothing selected.${C_RESET}"
        exit 0
    fi

    clear
    show_header
    echo -e "  ${C_BOLD}Installing $count extension(s)...${C_RESET}"
    echo ""

    local current=0
    for i in "${!NAMES[@]}"; do
        if [ "${selected[$i]}" -eq 1 ]; then
            current=$((current + 1))
            local name="${NAMES[$i]}"
            local url="$EXTENSIONS_URL/$name/install"
            local action="installing"
            [ "${STATUS[$i]}" = "update" ] && action="updating"
            [ "${STATUS[$i]}" = "installed" ] && action="reinstalling"

            echo -ne "  ${C_GRAY}[$current/$count]${C_RESET} ${action} ${C_CYAN}$name${C_RESET}... "

            local script_content=$(curl -sL "$url")
            if [ -z "$script_content" ]; then
                echo -e "${C_RED}✗ download failed${C_RESET}"
                failed=$((failed + 1))
                continue
            fi

            if echo "$script_content" | bash > /dev/null 2>&1; then
                echo -e "${C_GREEN}✓${C_RESET} ${C_GRAY}v${VERSIONS[$i]}${C_RESET}"
                success=$((success + 1))
            else
                echo -e "${C_RED}✗ install failed${C_RESET}"
                failed=$((failed + 1))
            fi

            [ "$name" = "ctx" ] && ctx_selected=true
        fi
    done

    echo ""
    echo -e "  ${C_GRAY}────────────────────────────────────────${C_RESET}"
    if [ $failed -eq 0 ]; then
        echo -e "  ${C_GREEN}✓ All $success extension(s) installed successfully.${C_RESET}"
    else
        echo -e "  ${C_GREEN}✓ $success installed${C_RESET} │ ${C_RED}✗ $failed failed${C_RESET}"
    fi

    if [ "$ctx_selected" = true ]; then
        if ! git config --global --get ctx.provider > /dev/null 2>&1; then
            configure_ctx_profile
        else
            local provider=$(git config --global --get ctx.provider)
            echo -e "\n  ${C_GRAY}ctx already configured (provider: $provider).${C_RESET}"
        fi
    fi
    echo ""
}

# --- Modes ---

mode_update() {
    show_header
    echo -e "  ${C_BOLD}Updating all installed extensions...${C_RESET}"
    echo ""

    local count=0
    local updated=0

    for i in "${!NAMES[@]}"; do
        if [ "${STATUS[$i]}" = "installed" ] || [ "${STATUS[$i]}" = "update" ]; then
            count=$((count + 1))
            local name="${NAMES[$i]}"
            local url="$EXTENSIONS_URL/$name/install"

            echo -ne "  ${C_GRAY}[$count]${C_RESET} ${C_CYAN}$name${C_RESET}... "

            local script_content=$(curl -sL "$url")
            if [ -n "$script_content" ] && echo "$script_content" | bash > /dev/null 2>&1; then
                if [ "${STATUS[$i]}" = "update" ]; then
                    echo -e "${C_MAGENTA}↑${C_RESET} ${C_GRAY}${LOCAL_VERSIONS[$i]} → ${VERSIONS[$i]}${C_RESET}"
                    updated=$((updated + 1))
                else
                    echo -e "${C_GREEN}✓${C_RESET} ${C_GRAY}v${VERSIONS[$i]}${C_RESET}"
                fi
            else
                echo -e "${C_RED}✗${C_RESET}"
            fi
        fi
    done

    echo ""
    if [ $updated -gt 0 ]; then
        echo -e "  ${C_GREEN}✓ $updated extension(s) updated, $((count - updated)) already current.${C_RESET}"
    else
        echo -e "  ${C_GREEN}✓ All $count extension(s) are up to date.${C_RESET}"
    fi
    echo ""
}

mode_list() {
    echo -e "${C_CYAN}Installed git extensions:${C_RESET}"
    echo ""

    local count=0
    for i in "${!NAMES[@]}"; do
        if [ "${STATUS[$i]}" = "installed" ] || [ "${STATUS[$i]}" = "update" ]; then
            local badge=$(get_status_badge "${STATUS[$i]}")
            local ver="${LOCAL_VERSIONS[$i]:-${VERSIONS[$i]}}"
            echo -e "  ${badge} ${NAMES[$i]} ${C_GRAY}v${ver}${C_RESET} ${C_GRAY}─ ${DESCRIPTIONS[$i]}${C_RESET}"
            count=$((count + 1))
        fi
    done

    if [ $count -eq 0 ]; then
        echo -e "  ${C_YELLOW}No extensions installed.${C_RESET}"
    else
        echo ""
        echo -e "  ${C_GRAY}$count extension(s) installed.${C_RESET}"
    fi
    echo ""
}

mode_uninstall() {
    echo -e "${C_CYAN}${C_BOLD}Uninstall git extensions${C_RESET}"
    echo ""

    local installed_names=()
    local installed_vers=()

    for i in "${!NAMES[@]}"; do
        if [ "${STATUS[$i]}" = "installed" ] || [ "${STATUS[$i]}" = "update" ]; then
            installed_names+=("${NAMES[$i]}")
            installed_vers+=("${LOCAL_VERSIONS[$i]:-${VERSIONS[$i]}}")
        fi
    done

    if [ ${#installed_names[@]} -eq 0 ]; then
        echo -e "  ${C_YELLOW}No extensions installed.${C_RESET}"
        exit 0
    fi

    echo -e "  ${C_GRAY}Select extensions to uninstall (space-separated numbers, or 'a' for all):${C_RESET}"
    echo ""

    for i in "${!installed_names[@]}"; do
        echo -e "    ${C_CYAN}$((i+1)))${C_RESET} ${installed_names[$i]} ${C_GRAY}v${installed_vers[$i]}${C_RESET}"
    done
    echo ""

    local choice
    read -p "  > " choice < /dev/tty

    if [ -z "$choice" ]; then
        echo -e "  ${C_GRAY}Cancelled.${C_RESET}"
        exit 0
    fi

    local to_remove=()
    if [[ "$choice" =~ ^[aA]$ ]]; then
        to_remove=("${installed_names[@]}")
    else
        for num in $choice; do
            if [[ "$num" =~ ^[0-9]+$ ]] && [ "$num" -ge 1 ] && [ "$num" -le "${#installed_names[@]}" ]; then
                to_remove+=("${installed_names[$((num-1))]}")
            fi
        done
    fi

    if [ ${#to_remove[@]} -eq 0 ]; then
        echo -e "  ${C_YELLOW}No valid selection.${C_RESET}"
        exit 0
    fi

    echo ""
    echo -e "  ${C_YELLOW}Will uninstall ${#to_remove[@]} extension(s):${C_RESET}"
    for name in "${to_remove[@]}"; do
        echo -e "    ${C_RED}✗${C_RESET} $name"
    done
    echo ""

    read -p "  Confirm? [y/N] " confirm < /dev/tty
    case "$confirm" in
        [yY][eE][sS]|[yY]) ;;
        *) echo -e "  ${C_GRAY}Cancelled.${C_RESET}"; exit 0 ;;
    esac

    echo ""
    for name in "${to_remove[@]}"; do
        if git config --global --unset "alias.$name" 2>/dev/null; then
            echo -e "  ${C_RED}✗${C_RESET} Removed ${C_CYAN}$name${C_RESET}"
        else
            echo -e "  ${C_YELLOW}⚠${C_RESET} $name not found"
        fi
    done

    echo ""
    echo -e "  ${C_GREEN}✓ Done. ${#to_remove[@]} extension(s) uninstalled.${C_RESET}"
    echo ""
}

mode_self_update() {
    echo -e "  ${C_CYAN}Updating git extension manager...${C_RESET}"
    echo ""

    local installer_url="$BASE_URL/alias/installer/script"
    local script_content=$(curl -sL "$installer_url")

    if [ -z "$script_content" ]; then
        echo -e "  ${C_RED}✗ Failed to download update.${C_RESET}"
        exit 1
    fi

    local remote_ver=$(echo "$script_content" | grep -oP '^VERSION="[^"]*"' | head -1 | sed 's/VERSION="//;s/"//')

    if [ -n "$remote_ver" ] && [ "$remote_ver" = "$VERSION" ]; then
        echo -e "  ${C_GREEN}✓ Already up to date (v$VERSION).${C_RESET}"
        exit 0
    fi

    echo -e "  ${C_GRAY}Local:  v$VERSION${C_RESET}"
    echo -e "  ${C_MAGENTA}Remote: v${remote_ver:-unknown}${C_RESET}"
    echo ""

    if echo "$script_content" | bash > /dev/null 2>&1; then
        echo -e "  ${C_GREEN}✓ Extension manager updated to v${remote_ver:-latest}.${C_RESET}"
    else
        echo -e "  ${C_RED}✗ Update failed.${C_RESET}"
        exit 1
    fi
    echo ""
}

# --- Main ---

main() {
    check_dependencies

    case "${1:-}" in
        -h|--help|help)              show_help ;;
        -v|--version|version)        echo "git extension v$VERSION"; exit 0 ;;
        update|--update|-u)          fetch_registry; parse_registry; resolve_status; mode_update; exit 0 ;;
        list|--list|-l)              fetch_registry; parse_registry; resolve_status; mode_list; exit 0 ;;
        remove|--remove|--uninstall) fetch_registry; parse_registry; resolve_status; mode_uninstall; exit 0 ;;
        self-update|--self-update)   mode_self_update; exit 0 ;;
        "")                          ;; # interactive
        *)
            echo -e "${C_RED}Unknown: $1${C_RESET}"
            show_help
            ;;
    esac

    show_header
    fetch_registry
    parse_registry
    resolve_status
    echo ""
    handle_input
    execute_tasks
}

main "$@"
EOF
)

ESCAPED_CODE=$(echo "$SCRIPT_CONTENT" | sed "s/'/'\\\\''/g")

git config --global alias.extension "!f() {
    bash -c '$ESCAPED_CODE' -- \"\$@\"
}; f"
