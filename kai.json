{
  "project_name": "Dotfiles",
  "icon": "terminal",
  "commands": [
    { "name": "Ver README.md", "folder": "Sobre", "type": "shell",
      "command": "cat README.md",
      "working_dir": "{{PROJECT_PATH}}" },

    { "name": "Instalar extensions (todas)", "folder": "Instalar", "type": "shell",
      "command": "for f in extensions/*/install; do echo \"==> $f\"; bash \"$f\"; done",
      "working_dir": "{{PROJECT_PATH}}" },
    { "name": "Instalar extension (uma)", "folder": "Instalar", "type": "shell",
      "command": "bash \"extensions/{{EXTENSION}}/install\"",
      "working_dir": "{{PROJECT_PATH}}",
      "params": [
        { "name": "EXTENSION", "label": "Nome da extension (ctx, pr, marry, quiver, sync, shh, ...)", "type": "text", "default": "" }
      ] },
    { "name": "Instalar nav (reinstala no ~/.bashrc)", "folder": "Instalar", "type": "shell",
      "command": "sed -i '\\|bashrc/nav|d' ~/.bashrc; echo 'source \"{{PROJECT_PATH}}/bashrc/nav\"' >> ~/.bashrc; echo 'nav reinstalado em ~/.bashrc (inclui autocomplete). Abra um novo terminal (ou rode: source ~/.bashrc).'",
      "working_dir": "{{PROJECT_PATH}}" },

    { "name": "nav — listar aliases de pasta", "folder": "Nav", "type": "shell",
      "command": "bash -c \"source bashrc/nav && nav list\"", "working_dir": "{{PROJECT_PATH}}" },
    { "name": "nav — definir alias", "folder": "Nav", "type": "shell",
      "command": "bash -c \"source bashrc/nav && nav set --alias {{ALIAS}} --path {{CAMINHO}}\"",
      "working_dir": "{{PROJECT_PATH}}",
      "params": [
        { "name": "ALIAS", "label": "Nome do alias", "type": "text", "default": "" },
        { "name": "CAMINHO", "label": "Caminho da pasta", "type": "text", "default": "" }
      ] },
    { "name": "nav — remover alias", "folder": "Nav", "type": "shell",
      "command": "bash -c \"source bashrc/nav && nav unset {{ALIAS}}\"",
      "working_dir": "{{PROJECT_PATH}}",
      "params": [
        { "name": "ALIAS", "label": "Nome do alias", "type": "text", "default": "" }
      ] },
    { "name": "nav — exportar aliases", "folder": "Nav", "type": "shell",
      "command": "bash -c \"source bashrc/nav && nav export\"", "working_dir": "{{PROJECT_PATH}}" },
    { "name": "nav — importar aliases", "folder": "Nav", "type": "shell",
      "command": "bash -c \"source bashrc/nav && nav import {{ARQUIVO}}\"",
      "working_dir": "{{PROJECT_PATH}}",
      "params": [
        { "name": "ARQUIVO", "label": "Arquivo de aliases", "type": "file", "default": "" }
      ] },
    { "name": "nav — ajuda", "folder": "Nav", "type": "shell",
      "command": "bash -c \"source bashrc/nav && nav help\"", "working_dir": "{{PROJECT_PATH}}" }
  ]
}
