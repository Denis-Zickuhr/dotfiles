#!/bin/bash

SCRIPT_CONTENT=$(cat <<'EOF'
    GREEN="\033[0;32m"; YELLOW="\033[1;33m"; CYAN="\033[0;36m"; RED="\033[0;31m"; GRAY="\033[90m"; NC="\033[0m";
    VERSION="1.0.0";

    show_help() {
        cat <<-MSG
Usage: git ctx [options]

Shows contextual information about the current branch.

Options:
    -b, --branch        Show only the branch name
    -t, --ticket        Show only the ticket/issue link
    -p, --pr            Show only the PR info
    --set-provider <p>  Set the ticket provider (jira, linear, github-issues)
    --set-domain <d>    Set the provider domain/workspace
    --set-prefix <x>    Set a custom URL prefix (overrides provider logic)
    --setup             Interactive provider setup
    --show-config       Show current ctx configuration
    --clear             Remove all ctx configuration
    -h, --help          Show this help message
    -v, --version       Show version

Providers:
    jira               Atlassian Jira (requires domain)
    linear             Linear.app (uses team from branch prefix)
    github-issues      GitHub Issues (auto-detects from remote)

Examples:
    git ctx --set-provider jira
    git ctx --set-domain mycompany.atlassian.net
    git ctx
MSG
        exit 0
    }

    get_config() {
        local key=$1
        git config --global --get "ctx.$key" 2>/dev/null || echo ""
    }

    set_config() {
        local key=$1 value=$2
        git config --global "ctx.$key" "$value"
    }

    get_branch() {
        git rev-parse --abbrev-ref HEAD 2>/dev/null
    }

    extract_prefix() {
        local branch=$1
        echo "$branch" | grep -oE "[A-Za-z]+-[0-9]+" | head -n 1
    }

    resolve_ticket_url() {
        local branch=$1
        local provider=$(get_config "provider")
        local domain=$(get_config "domain")
        local custom_prefix=$(get_config "prefix")
        local prefix=$(extract_prefix "$branch")

        if [ -z "$prefix" ]; then
            echo ""
            return
        fi

        # Custom prefix takes priority
        if [ -n "$custom_prefix" ]; then
            echo "${custom_prefix}${prefix}"
            return
        fi

        case "$provider" in
            jira)
                if [ -z "$domain" ]; then
                    echo -e "${YELLOW}Provider 'jira' requires a domain. Run: git ctx --set-domain <your-domain>.atlassian.net${NC}" >&2
                    return
                fi
                echo "https://${domain}/browse/${prefix}"
                ;;
            linear)
                local team=$(echo "$prefix" | grep -oE "^[A-Za-z]+" | head -n 1)
                echo "https://linear.app/team/${team}/issue/${prefix}"
                ;;
            github-issues)
                local remote_url=$(git config --get remote.origin.url 2>/dev/null)
                local repo_path=$(echo "$remote_url" | sed -E "s#(git@github.com:|https://github.com/)([^.]+)(.git)?#\2#")
                local issue_num=$(echo "$prefix" | grep -oE "[0-9]+")
                if [ -n "$repo_path" ] && [ -n "$issue_num" ]; then
                    echo "https://github.com/${repo_path}/issues/${issue_num}"
                fi
                ;;
            "")
                echo ""
                ;;
            *)
                echo -e "${RED}Unknown provider: $provider${NC}" >&2
                ;;
        esac
    }

    resolve_pr() {
        local branch=$1

        if ! command -v gh &> /dev/null; then
            echo -e "${GRAY}(gh CLI not installed)${NC}"
            return
        fi

        local pr_info=$(gh pr list --head "$branch" --json url,state --jq '.[0] | "\(.state) \(.url)"' 2>/dev/null)

        if [ -n "$pr_info" ]; then
            local state=$(echo "$pr_info" | awk '{print $1}')
            local url=$(echo "$pr_info" | awk '{print $2}')
            echo "$url"
        else
            # Generate create link
            local remote_url=$(git config --get remote.origin.url 2>/dev/null)
            local repo_path=$(echo "$remote_url" | sed -E "s#(git@github.com:|https://github.com/)([^.]+)(.git)?#\2#")
            local default_branch=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed "s|origin/||")
            default_branch=${default_branch:-main}
            if [ -n "$repo_path" ]; then
                echo "https://github.com/${repo_path}/compare/${default_branch}...${branch}?expand=1 ${GRAY}(create)${NC}"
            fi
        fi
    }

    show_config() {
        local provider=$(get_config "provider")
        local domain=$(get_config "domain")
        local prefix=$(get_config "prefix")

        echo -e "${CYAN}ctx configuration:${NC}"
        echo -e "  provider: ${GREEN}${provider:-<not set>}${NC}"
        echo -e "  domain:   ${GREEN}${domain:-<not set>}${NC}"
        echo -e "  prefix:   ${GREEN}${prefix:-<not set>}${NC}"
    }

    clear_config() {
        git config --global --remove-section ctx 2>/dev/null || true
        echo -e "${GREEN}ctx configuration cleared.${NC}"
    }

    show_full() {
        local branch=$(get_branch)
        if [ -z "$branch" ]; then
            echo -e "${RED}Not in a git repository.${NC}"
            exit 1
        fi

        echo -e "${GREEN}${branch}${NC}"

        local ticket=$(resolve_ticket_url "$branch")
        if [ -n "$ticket" ]; then
            echo -e "\n🎫 ${ticket}"
        fi

        local pr=$(resolve_pr "$branch")
        if [ -n "$pr" ]; then
            echo -e "🔗 ${pr}"
        fi
    }

    setup_interactive() {
        echo -e "${CYAN}ctx provider setup${NC}"
        echo ""
        echo -e "  ${GRAY}1)${NC} jira          ${GRAY}(Atlassian Jira)${NC}"
        echo -e "  ${GRAY}2)${NC} linear        ${GRAY}(Linear.app)${NC}"
        echo -e "  ${GRAY}3)${NC} github-issues ${GRAY}(GitHub Issues)${NC}"
        echo -e "  ${GRAY}4)${NC} custom        ${GRAY}(Custom URL prefix)${NC}"
        echo ""

        local choice
        read -p "  Choose provider: " choice < /dev/tty

        case "$choice" in
            1|jira)
                read -p "  Jira domain (e.g., mycompany.atlassian.net): " domain < /dev/tty
                [ -z "$domain" ] && { echo -e "${RED}Domain required.${NC}"; return; }
                [[ "$domain" != *".atlassian.net"* ]] && [[ "$domain" != *"."* ]] && domain="${domain}.atlassian.net"
                set_config "provider" "jira"
                set_config "domain" "$domain"
                git config --global --unset ctx.prefix 2>/dev/null || true
                echo -e "${GREEN}✓ Provider: jira (${domain})${NC}"
                ;;
            2|linear)
                read -p "  Linear workspace slug: " workspace < /dev/tty
                [ -z "$workspace" ] && { echo -e "${RED}Workspace required.${NC}"; return; }
                set_config "provider" "linear"
                set_config "domain" "$workspace"
                git config --global --unset ctx.prefix 2>/dev/null || true
                echo -e "${GREEN}✓ Provider: linear (${workspace})${NC}"
                ;;
            3|github-issues|github)
                set_config "provider" "github-issues"
                git config --global --unset ctx.domain 2>/dev/null || true
                git config --global --unset ctx.prefix 2>/dev/null || true
                echo -e "${GREEN}✓ Provider: github-issues (auto-detected from remote)${NC}"
                ;;
            4|custom)
                read -p "  URL prefix (e.g., https://tracker.com/browse/): " prefix < /dev/tty
                [ -z "$prefix" ] && { echo -e "${RED}Prefix required.${NC}"; return; }
                [[ "$prefix" != */ ]] && prefix="${prefix}/"
                set_config "provider" "custom"
                set_config "prefix" "$prefix"
                echo -e "${GREEN}✓ Provider: custom (${prefix})${NC}"
                ;;
            *)
                echo -e "${YELLOW}Cancelled.${NC}"
                ;;
        esac
    }

    # --- Main ---
    case "$1" in
        -b|--branch)
            get_branch
            ;;
        -t|--ticket)
            branch=$(get_branch)
            ticket=$(resolve_ticket_url "$branch")
            if [ -n "$ticket" ]; then
                echo "$ticket"
            else
                echo -e "${YELLOW}No ticket prefix found in branch name.${NC}"
            fi
            ;;
        -p|--pr)
            branch=$(get_branch)
            resolve_pr "$branch"
            ;;
        --set-provider)
            if [ -z "$2" ]; then
                echo -e "${RED}Usage: git ctx --set-provider <jira|linear|github-issues>${NC}"
                exit 1
            fi
            set_config "provider" "$2"
            echo -e "${GREEN}Provider set to '$2'.${NC}"
            ;;
        --set-domain)
            if [ -z "$2" ]; then
                echo -e "${RED}Usage: git ctx --set-domain <domain>${NC}"
                exit 1
            fi
            set_config "domain" "$2"
            echo -e "${GREEN}Domain set to '$2'.${NC}"
            ;;
        --set-prefix)
            if [ -z "$2" ]; then
                echo -e "${RED}Usage: git ctx --set-prefix <url-prefix>${NC}"
                exit 1
            fi
            set_config "prefix" "$2"
            echo -e "${GREEN}Custom prefix set to '$2'.${NC}"
            ;;
        --show-config)
            show_config
            ;;
        --setup)
            setup_interactive
            ;;
        --clear)
            clear_config
            ;;
        -h|--help)
            show_help
            ;;
        -v|--version)
            echo "git-ctx $VERSION"
            ;;
        "")
            show_full
            ;;
        *)
            echo -e "${RED}Unknown option: $1${NC}"
            show_help
            ;;
    esac
EOF
)

ESCAPED_CODE=$(echo "$SCRIPT_CONTENT" | sed "s/'/'\\\\''/g")

git config --global alias.ctx "!f() {
    bash -c '$ESCAPED_CODE' -- \"\$@\"
}; f"
