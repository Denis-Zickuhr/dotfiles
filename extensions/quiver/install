#!/bin/bash

SCRIPT_CONTENT=$(cat <<'EOF'
    VERSION="2.0.0"
    GREEN="\033[0;32m"; YELLOW="\033[1;33m"; CYAN="\033[0;36m"; RED="\033[0;31m"; GRAY="\033[90m"; BOLD="\033[1m"; NC="\033[0m"

    if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
        echo -e "${RED}Error: Not in a git repository.${NC}"
        exit 1
    fi

    # --- Quiver commands registry ---
    # remote: can run targeting any branch without checkout
    QUIVER_CMDS_REMOTE="ctx pr hotfix sync"
    QUIVER_COMMANDS="$QUIVER_CMDS_REMOTE"

    get_quiver() {
        git config --local --get-all quiver.branch 2>/dev/null || echo ""
    }

    save_quiver() {
        git config --local --unset-all quiver.branch 2>/dev/null || true
        for branch in "$@"; do
            [ -n "$branch" ] && git config --local --add quiver.branch "$branch"
        done
    }

    get_current_stash_name() {
        local branch=$1
        local hash=$(git rev-parse --short HEAD)
        echo "$hash-quiver-stash-$branch"
    }

    manage_stash_push() {
        local branch=$(git branch --show-current)
        if [ -n "$(git status --porcelain)" ]; then
            local msg=$(get_current_stash_name "$branch")
            git stash push -m "$msg" > /dev/null
            echo -e "${YELLOW}Changes stashed.${NC}"
        fi
    }

    manage_stash_pop() {
        local branch=$1
        local msg=$(get_current_stash_name "$branch")
        local stash_id=$(git stash list | grep "$msg" | cut -d: -f1 | head -n 1 || true)
        if [ -n "$stash_id" ]; then
            git stash pop "$stash_id" > /dev/null
            echo -e "${YELLOW}Changes restored.${NC}"
        fi
    }

    help() {
        echo -e "${BOLD}${CYAN}git quiver v$VERSION${NC} — Interactive branch manager"
        echo ""
        echo -e "${YELLOW}Usage:${NC} git quiver [index | command | flags]"
        echo ""
        echo -e "${YELLOW}Flags:${NC}"
        echo "  -h, --help                Show this help page"
        echo "  -v, --version             Show version"
        echo "  -a, --add [branch]        Add branch to quiver (current if empty)"
        echo "  -r, --remove [index]      Remove branch from quiver by display index"
        echo "  -f, --filter [regexp]     Filter and pick from origin branches"
        echo "  -t, --top                 Move current branch to top of quiver"
        echo "  -b, --bottom              Move current branch to bottom of quiver"
        echo "  -m, --clean-merged        Remove merged branches from quiver"
        echo "  -e, --empty               Empty quiver"
        echo ""
        echo -e "${YELLOW}Interactive:${NC}"
        echo "  git quiver                Open fullscreen branch picker"
        echo "  git quiver [n]            Switch directly to branch at index n"
        echo "  git quiver f              Switch to default (main) branch"
        echo ""
        echo -e "${YELLOW}Picker keys:${NC}"
        echo "  ↑/↓ or j/k                Move selection"
        echo "  ←/→ or h/l                Page"
        echo "  type                      Filter branches"
        echo "  Enter                     Switch to highlighted branch"
        echo "  Tab                       Open action mode (run a command on it)"
        echo "  a                         Add current branch to quiver"
        echo "  Esc / q                   Quit"
        echo ""
        echo -e "${GRAY}  Note: Tab opens actions because terminals can't distinguish${NC}"
        echo -e "${GRAY}  Ctrl+Enter from Enter (same byte).${NC}"
        echo ""
        echo -e "${YELLOW}Action mode commands:${NC} ${GRAY}ctx · pr · hotfix · sync${NC}"
    }

    is_quiver_command() {
        local input=$1
        for cmd in $QUIVER_COMMANDS; do
            [ "$cmd" = "$input" ] && return 0
        done
        return 1
    }

    run_quiver_command() {
        local cmd=$1
        shift
        local target_branch=""
        local run_all=false
        local cmd_args=""

        # Scan all args: extract . (all) or index, rest becomes cmd_args
        local remaining=()
        local index_found=""
        for arg in "$@"; do
            if [ "$arg" = "." ] && [ "$run_all" = false ] && [ -z "$index_found" ]; then
                run_all=true
            elif [[ "$arg" =~ ^[0-9]+$ ]] && [ "$run_all" = false ] && [ -z "$index_found" ]; then
                index_found="$arg"
            else
                remaining+=("$arg")
            fi
        done

        cmd_args="${remaining[*]}"

        # Resolve target branch from index
        if [ -n "$index_found" ]; then
            local idx=$((index_found - 1))
            local branches=($(get_quiver))
            local main_branch=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed "s|origin/||")
            main_branch=${main_branch:-main}

            local display_indices=()
            for i in "${!branches[@]}"; do
                [ "${branches[$i]}" == "$main_branch" ] && continue
                display_indices+=("$i")
            done

            if [ "$idx" -ge 0 ] && [ "$idx" -lt "${#display_indices[@]}" ]; then
                local array_idx="${display_indices[$idx]}"
                target_branch="${branches[$array_idx]}"
            else
                echo -e "  ${RED}Invalid index.${NC}"
                return 1
            fi
        fi

        if ! git config --global --get "alias.$cmd" > /dev/null 2>&1; then
            echo -e "  ${RED}'git $cmd' is not installed.${NC}"
            echo -e "  ${GRAY}Install via: git extension${NC}"
            return 1
        fi

        # Auto-inject --abort-on-fail for sync (prevents broken rebase state)
        if [ "$cmd" = "sync" ]; then
            cmd_args="--abort-on-fail $cmd_args"
        fi

        local current=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

        # Run on ALL branches
        if [ "$run_all" = true ]; then
            # Block commands that don't make sense with .
            if [ "$cmd" = "hotfix" ]; then
                echo -e "  ${RED}hotfix doesn't support '.'. Use with a specific index.${NC}"
                return 1
            fi

            local branches=($(get_quiver))
            local main_branch=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed "s|origin/||")
            main_branch=${main_branch:-main}

            echo ""
            local display_num=1
            for i in "${!branches[@]}"; do
                local b="${branches[$i]}"
                [ "$b" == "$main_branch" ] && continue

                echo -e "  ${GRAY}[$display_num]${NC} ${b}"
                if [ "$b" = "$current" ]; then
                    local output=$(git "$cmd" $cmd_args 2>&1)
                    local exit_code=$?
                else
                    git checkout "$b" > /dev/null 2>&1
                    local output=$(git "$cmd" $cmd_args 2>&1)
                    local exit_code=$?
                    git checkout "$current" > /dev/null 2>&1
                fi

                if [ $exit_code -ne 0 ]; then
                    echo -e "      ${RED}✗ failed${NC} ${GRAY}(conflict or error)${NC}"
                else
                    echo "$output" | grep -v "^$" | tail -n +2 | sed 's/^/      /'
                fi
                display_num=$((display_num + 1))
            done
            echo ""
            return
        fi

        echo ""

        if [ -z "$target_branch" ] || [ "$target_branch" = "$current" ]; then
            echo -e "  ${CYAN}git $cmd $cmd_args${NC} ${GRAY}on ${current}${NC}"
            echo -e "  ${GRAY}─────────────────────────────────────────${NC}"
            git "$cmd" $cmd_args
            echo -e "  ${GRAY}─────────────────────────────────────────${NC}"
        elif [ "$cmd" = "hotfix" ]; then
            # Hotfix: pass -f <branch> instead of checkout
            echo -e "  ${CYAN}git hotfix -f $target_branch $cmd_args${NC}"
            echo -e "  ${GRAY}─────────────────────────────────────────${NC}"
            git hotfix -f "$target_branch" $cmd_args
            echo -e "  ${GRAY}─────────────────────────────────────────${NC}"
        else
            echo -e "  ${CYAN}git $cmd $cmd_args${NC} ${GRAY}on ${target_branch}${NC}"
            echo -e "  ${GRAY}─────────────────────────────────────────${NC}"
            git checkout "$target_branch" > /dev/null 2>&1
            git "$cmd" $cmd_args
            git checkout "$current" > /dev/null 2>&1
            echo -e "  ${GRAY}─────────────────────────────────────────${NC}"
        fi
    }

    perform_switch() {
        local target=$1
        local current=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

        if [ "$current" == "$target" ]; then
            echo -e "Already on ${GREEN}$target${NC}. Updating..."
            git fetch origin "$target" > /dev/null 2>&1 || true
            if ! git pull origin "$target" 2>&1; then
                echo -e "${RED}Pull failed. You may have conflicts or network issues.${NC}"
                return 1
            fi
            return 0
        fi

        manage_stash_push

        if ! git checkout "$target" > /dev/null 2>&1; then
            echo -e "${CYAN}Branch not found locally. Trying origin...${NC}"
            if ! git checkout --track "origin/$target" > /dev/null 2>&1; then
                echo -e "${RED}Error: Branch '$target' not found locally or on origin.${NC}"
                return 1
            fi
        fi

        echo -e "${CYAN}Updating $target...${NC}"
        git fetch origin "$target" > /dev/null 2>&1 || true

        local pull_output
        if ! pull_output=$(git pull origin "$target" 2>&1); then
            echo -e "${RED}Pull failed on $target:${NC}"
            echo "$pull_output"
            echo -e "${YELLOW}You may need to resolve conflicts manually.${NC}"
        fi

        echo -e "Switched to branch ${GREEN}$target${NC}"
        manage_stash_pop "$target"
    }

    # --- Action mode: pick a command to run against the highlighted branch ---
    # Fullscreen sub-picker. Returns after running (or cancelling) a command.
    action_mode() {
        local target_branch="$1"     # branch the action runs against ("" = current)
        local -a acts=($QUIVER_COMMANDS)
        local sel=0 n=${#acts[@]}
        local descA=( "context: ticket + PR status" "show/create pull request" \
                      "cherry-pick into targets" "sync with upstream (rebase)" )

        local old_stty=""; old_stty=$(stty -g 2>/dev/null)
        _act_cleanup() { [ -n "$old_stty" ] && stty "$old_stty" 2>/dev/null; tput cnorm 2>/dev/null; }
        stty -echo -icanon min 1 time 0 2>/dev/null
        tput civis 2>/dev/null

        local label="${target_branch:-$(git rev-parse --abbrev-ref HEAD 2>/dev/null)}"
        local chosen="" extra=""
        while true; do
            printf '\033[H\033[J'
            printf '  \033[1;36mAction mode\033[0m \033[2m— run on\033[0m \033[32m%s\033[0m\n\n' "$label"
            local i
            for (( i=0; i<n; i++ )); do
                if [ "$i" -eq "$sel" ]; then
                    printf '  \033[7m› git %-8s\033[0m \033[2m%s\033[0m\n' "${acts[$i]}" "${descA[$i]}"
                else
                    printf '    git %-8s \033[2m%s\033[0m\n' "${acts[$i]}" "${descA[$i]}"
                fi
            done
            printf '\n  \033[2m↑/↓ move · Enter run · Esc/Tab back\033[0m\n'

            local key="" k2="" k3=""
            IFS= read -rsn1 key
            if [ "$key" = $'\x1b' ]; then
                IFS= read -rsn1 -t 0.05 k2
                if [ "$k2" = '[' ]; then
                    IFS= read -rsn1 -t 0.05 k3
                    case "$k3" in
                        A) sel=$(( (sel-1+n)%n ));;
                        B) sel=$(( (sel+1)%n ));;
                    esac
                else
                    break   # bare Esc = back
                fi
            elif [ "$key" = $'\t' ]; then
                break       # Tab = back
            elif [ -z "$key" ]; then
                chosen="${acts[$sel]}"; break   # Enter = run
            elif [ "$key" = 'q' ]; then
                break
            else
                case "$key" in
                    k) sel=$(( (sel-1+n)%n ));;
                    j) sel=$(( (sel+1)%n ));;
                esac
            fi
        done

        _act_cleanup
        printf '\033[H\033[J'
        [ -z "$chosen" ] && return 1

        # hotfix needs targets; ask for them on a normal prompt.
        if [ "$chosen" = "hotfix" ]; then
            printf "  ${CYAN}git hotfix${NC} targets (space separated): "
            read -r extra < /dev/tty
            [ -z "$extra" ] && { echo -e "  ${YELLOW}No targets — cancelled.${NC}"; return 1; }
        fi

        # Build args for run_quiver_command: [index] [extra]
        # It resolves the branch from a display index; "" means current.
        if [ -n "$target_branch" ] && [ -n "$ACTION_INDEX" ]; then
            run_quiver_command "$chosen" "$ACTION_INDEX" $extra
        else
            run_quiver_command "$chosen" $extra
        fi
        echo ""
        printf "  ${GRAY}Press any key to return...${NC}"
        read -rsn1 < /dev/tty
        return 0
    }

    # --- Interactive fullscreen picker (nav-style) ---------------------------
    # ↑/↓ or j/k move · ←/→ or h/l page · type to filter · Enter switch ·
    # Tab open action mode · a add current · Esc/q quit.
    # NOTE: Ctrl+Enter is NOT distinguishable from Enter in a standard terminal
    # (both send the same byte), so Tab is used to open action mode instead.
    quiver() {
        local main_branch=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed "s|origin/||")
        main_branch=${main_branch:-main}
        local current=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

        # Build the item list: main first, then quiver branches (excluding main),
        # then current branch if it's not already present.
        local -a branches=($(get_quiver))
        local -a items=() ; local -a is_main=()
        items+=("$main_branch"); is_main+=(1)
        local -a display_map=()   # for each item, its quiver display index ("" if none)
        display_map+=("")
        local dnum=1 b
        for b in "${branches[@]}"; do
            [ "$b" = "$main_branch" ] && continue
            items+=("$b"); is_main+=(0); display_map+=("$dnum")
            dnum=$((dnum+1))
        done
        # current not in list?
        local found=0
        for b in "${items[@]}"; do [ "$b" = "$current" ] && found=1; done
        [ "$found" -eq 0 ] && [ -n "$current" ] && { items+=("$current"); is_main+=(0); display_map+=(""); }

        if [ ${#items[@]} -eq 0 ]; then
            echo -e "  ${YELLOW}Empty. Use -a to add or -f to pick from origin.${NC}"
            return
        fi

        if [ ! -t 0 ] || [ ! -t 1 ]; then
            echo -e "  ${YELLOW}quiver needs a terminal for interactive mode.${NC}"
            return
        fi

        local query="" sel=0 editing=0 page_size=10
        local -a view=() view_idx=()

        _qv_filter() {
            view=(); view_idx=()
            local i it
            for i in "${!items[@]}"; do
                it="${items[$i]}"
                if [ -z "$query" ] || [[ "${it,,}" == *"${query,,}"* ]]; then
                    view+=("$it"); view_idx+=("$i")
                fi
            done
            local count=${#view[@]}
            if [ "$count" -eq 0 ]; then sel=0
            elif [ "$sel" -ge "$count" ]; then sel=$((count-1)); fi
        }

        _qv_render() {
            local count=${#view[@]}
            local total_pages=$(( (count + page_size - 1) / page_size )); [ "$total_pages" -lt 1 ] && total_pages=1
            local page=0; [ "$page_size" -gt 0 ] && page=$((sel / page_size))
            local start=$((page*page_size)) end=$((page*page_size+page_size-1))
            [ "$end" -gt $((count-1)) ] && end=$((count-1))

            printf '\033[H\033[J'
            printf '  \033[1;36mquiver\033[0m \033[2m— branch manager · %d branches\033[0m\n\n' "${#branches[@]}"
            printf '  Search: %s\033[7m \033[0m\n\n' "$query"
            if [ "$count" -eq 0 ]; then
                printf '    No matches.\n'
            else
                local i real name tag mark
                for (( i=start; i<=end; i++ )); do
                    real="${view_idx[$i]}"
                    name="${view[$i]}"
                    tag=""
                    [ "${is_main[$real]}" = 1 ] && tag=" \033[2m(default)\033[0m"
                    [ "$name" = "$current" ] && tag="$tag \033[32m●\033[0m"
                    if [ -n "${display_map[$real]}" ]; then
                        mark="\033[2m${display_map[$real]})\033[0m"
                    elif [ "${is_main[$real]}" = 1 ]; then
                        mark="\033[2mf)\033[0m"
                    else
                        mark="  "
                    fi
                    if [ "$i" -eq "$sel" ]; then
                        printf '  \033[7m› %b %s\033[0m%b\n' "$mark" "$name" "$tag"
                    else
                        printf '    %b %s%b\n' "$mark" "$name" "$tag"
                    fi
                done
            fi
            printf '\n  Page %d/%d   \033[2m↑/↓ move · ←/→ page · Enter switch · Tab actions · a add · Esc quit\033[0m\n' \
                "$((page+1))" "$total_pages"
        }

        _qv_move() { local c=${#view[@]}; [ "$c" -eq 0 ] && return
            sel=$((sel+$1)); [ "$sel" -lt 0 ] && sel=$((c-1)); [ "$sel" -ge "$c" ] && sel=0; }
        _qv_page() { local c=${#view[@]}; [ "$c" -eq 0 ] && return
            sel=$((sel+$1*page_size)); [ "$sel" -lt 0 ] && sel=0; [ "$sel" -gt $((c-1)) ] && sel=$((c-1)); }

        _qv_filter

        local old_stty=""; old_stty=$(stty -g 2>/dev/null)
        _qv_cleanup() { [ -n "$old_stty" ] && stty "$old_stty" 2>/dev/null; tput cnorm 2>/dev/null; printf '\033[H\033[J'; }
        stty -echo -icanon min 1 time 0 2>/dev/null
        tput civis 2>/dev/null

        local action="" chosen_name="" chosen_index=""
        while true; do
            _qv_render
            local key="" k2="" k3=""
            IFS= read -rsn1 key || break
            if [ "$key" = $'\x1b' ]; then
                IFS= read -rsn1 -t 0.05 k2
                if [ "$k2" = '[' ]; then
                    IFS= read -rsn1 -t 0.05 k3
                    case "$k3" in
                        A) _qv_move -1;; B) _qv_move 1;;
                        D) _qv_page -1;; C) _qv_page 1;;
                    esac
                elif [ -n "$query" ]; then
                    query=""; editing=0; _qv_filter
                else
                    break   # Esc quits
                fi
            elif [ "$key" = $'\t' ]; then
                if [ ${#view[@]} -gt 0 ]; then
                    action="run"
                    chosen_name="${view[$sel]}"
                    chosen_index="${display_map[${view_idx[$sel]}]}"
                    break
                fi
            elif [ -z "$key" ]; then
                if [ ${#view[@]} -gt 0 ]; then
                    action="switch"
                    chosen_name="${view[$sel]}"
                    break
                fi
            elif [ "$key" = $'\x7f' ] || [ "$key" = $'\x08' ]; then
                [ -n "$query" ] && { query="${query%?}"; [ -z "$query" ] && editing=0; _qv_filter; }
            elif [ "$key" = $'\x03' ]; then
                break   # Ctrl-C
            else
                case "$key" in
                    j) if [ "$editing" = 0 ]; then _qv_move 1; else query+="$key"; _qv_filter; fi;;
                    k) if [ "$editing" = 0 ]; then _qv_move -1; else query+="$key"; _qv_filter; fi;;
                    h) if [ "$editing" = 0 ]; then _qv_page -1; else query+="$key"; _qv_filter; fi;;
                    l) if [ "$editing" = 0 ]; then _qv_page 1; else query+="$key"; _qv_filter; fi;;
                    q) if [ "$editing" = 0 ]; then action="quit"; break; else query+="$key"; _qv_filter; fi;;
                    a) if [ "$editing" = 0 ]; then action="add"; break; else query+="$key"; _qv_filter; fi;;
                    *) editing=1; query+="$key"; _qv_filter;;
                esac
            fi
        done

        _qv_cleanup

        case "$action" in
            switch)
                perform_switch "$chosen_name"
                ;;
            run)
                # Determine the branch/index the action targets.
                if [ "$chosen_name" = "$current" ] || [ -z "$chosen_index" ]; then
                    ACTION_INDEX=""
                    action_mode ""
                else
                    ACTION_INDEX="$chosen_index"
                    action_mode "$chosen_name"
                fi
                ;;
            add)
                add_branch "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" "normal"
                ;;
            quit|"")
                return
                ;;
        esac
    }

    quiver_origin() {
        local regex=$1
        echo -e "${CYAN}Fetching branches from origin...${NC}"
        git fetch origin > /dev/null 2>&1

        local filter_pattern="${regex:-.*}"

        local filtered=($(git branch -r --no-color | grep "origin/" | grep -v "origin/HEAD" | sed 's|[[:space:]]*origin/||' | grep -iE -e "$filter_pattern"))

        if [ ${#filtered[@]} -eq 0 ]; then
            echo -e "${RED}No branches found matching: '$filter_pattern'${NC}"
            return
        fi

        echo ""
        local i=1
        for b in "${filtered[@]}"; do
            echo -e "    ${GRAY}$i)${NC} $b"
            i=$((i+1))
        done

        echo ""
        local choice
        read -p "  Select branch to add and switch: " choice < /dev/tty

        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#filtered[@]}" ]; then
            local target="${filtered[$((choice-1))]}"
            add_branch "$target" "normal"
            perform_switch "$target"
        else
            echo -e "${RED}Invalid choice.${NC}"
        fi
    }

    add_branch() {
        local target=${1:-$(git branch --show-current)}
        local pos=${2:-normal}
        local branches=($(get_quiver))

        for b in "${branches[@]}"; do
            if [ "$b" == "$target" ]; then
                echo -e "  ${YELLOW}'$target' already in quiver.${NC}"
                return
            fi
        done

        if [ "$pos" == "top" ]; then
            save_quiver "$target" "${branches[@]}"
        else
            save_quiver "${branches[@]}" "$target"
        fi
        echo -e "  ${GREEN}✓ Added '$target'${NC}"
    }

    remove_branch() {
        local target_display_index=$1
        local branches=($(get_quiver))

        if [[ -z "$target_display_index" ]] || [[ ! "$target_display_index" =~ ^[0-9]+$ ]]; then
            echo -e "${RED}Error: Provide a valid numeric index.${NC}"
            return 1
        fi

        local main_branch=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed "s|origin/||")
        main_branch=${main_branch:-main}

        local display_number=1
        local array_idx_to_remove=""

        for i in "${!branches[@]}"; do
            [ "${branches[$i]}" == "$main_branch" ] && continue
            if [ "$display_number" -eq "$target_display_index" ]; then
                array_idx_to_remove=$i
                break
            fi
            display_number=$((display_number + 1))
        done

        if [ -z "$array_idx_to_remove" ]; then
            echo -e "${RED}Error: Index $target_display_index out of range.${NC}"
            return 1
        fi

        local removed="${branches[$array_idx_to_remove]}"
        unset "branches[$array_idx_to_remove]"
        save_quiver "${branches[@]}"
        echo -e "  ${YELLOW}✗ Removed '$removed'${NC}"
    }

    clean_merged_branches() {
        local main_branch=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed "s|origin/||")
        main_branch=${main_branch:-main}

        echo -e "${CYAN}Fetching and pruning remote references...${NC}"
        git fetch origin --prune > /dev/null 2>&1 || true

        local branches=($(get_quiver))
        local kept_branches=()
        local removed_count=0
        local has_gh=false
        command -v gh > /dev/null 2>&1 && has_gh=true

        if [ "$has_gh" = false ]; then
            echo -e "  ${YELLOW}(gh CLI not found — squash-merge detection disabled)${NC}"
        fi

        local merged_list=$(git branch --merged "origin/$main_branch" 2>/dev/null | sed 's/^[* ]*//')

        for b in "${branches[@]}"; do
            if [ "$b" == "$main_branch" ]; then
                kept_branches+=("$b")
                continue
            fi

            local is_merged=false
            local reason=""

            if ! git rev-parse --verify "$b" > /dev/null 2>&1; then
                if ! git ls-remote --heads origin "$b" 2>/dev/null | grep -q "$b"; then
                    is_merged=true
                    reason="gone (local + remote)"
                else
                    kept_branches+=("$b")
                    continue
                fi
            elif git merge-base --is-ancestor "$b" "origin/$main_branch" 2>/dev/null; then
                is_merged=true
                reason="merged into $main_branch"
            elif echo "$merged_list" | grep -qxF "$b"; then
                is_merged=true
                reason="merged into $main_branch"
            elif ! git ls-remote --heads origin "$b" 2>/dev/null | grep -q "$b"; then
                is_merged=true
                reason="remote deleted"
            elif [ "$has_gh" = true ]; then
                local pr_state=$(gh pr list --head "$b" --state all --json state --jq '.[0].state' 2>/dev/null)
                if [ "$pr_state" = "MERGED" ] || [ "$pr_state" = "CLOSED" ]; then
                    is_merged=true
                    reason="PR $pr_state"
                fi
            fi

            if [ "$is_merged" = true ]; then
                echo -e "  ${RED}✗${NC} ${b} ${GRAY}(${reason})${NC}"
                removed_count=$((removed_count + 1))
            else
                kept_branches+=("$b")
            fi
        done

        save_quiver "${kept_branches[@]}"
        echo ""
        if [ $removed_count -eq 0 ]; then
            echo -e "  ${GREEN}No merged branches found.${NC}"
        else
            echo -e "  ${GREEN}✓ Removed $removed_count branch(es)${NC}"
        fi
    }

    reorder_branch() {
        local target=$(git branch --show-current)
        local pos=$1
        local branches=($(get_quiver))
        local new_branches=()

        for b in "${branches[@]}"; do
            [ "$b" != "$target" ] && new_branches+=("$b")
        done

        if [ "$pos" == "top" ]; then
            save_quiver "$target" "${new_branches[@]}"
        else
            save_quiver "${new_branches[@]}" "$target"
        fi
        echo -e "  ${GREEN}Moved '$target' to $pos.${NC}"
    }

    empty_quiver() {
        git config --local --unset-all quiver.branch 2>/dev/null || true
        echo -e "  ${YELLOW}Quiver emptied.${NC}"
    }

    main() {
        case "${1:-}" in
            -h|--help|help) help; exit 0 ;;
            -v|--version) echo "git quiver v$VERSION"; exit 0 ;;
            -a|--add)
                local branch=""
                if [[ -n "${2:-}" && "${2:-}" != -* ]]; then branch="$2"; fi
                add_branch "$branch" "normal"
                ;;
            -r|--remove)
                if [[ -n "${2:-}" ]]; then
                    remove_branch "$2"
                else
                    echo -e "${RED}Error: Provide an index.${NC}"
                    exit 1
                fi
                ;;
            -f|--filter)
                quiver_origin "${2:-}"
                ;;
            -t|--top) reorder_branch "top" ;;
            -b|--bottom) reorder_branch "bottom" ;;
            -m|--clean-merged) clean_merged_branches ;;
            -e|--empty) empty_quiver ;;
            *)
                if [ $# -eq 0 ]; then quiver; exit 0; fi

                if [[ "$1" =~ ^(f|F|fresh|FRESH)$ ]]; then
                    local main_branch=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed "s|origin/||")
                    main_branch=${main_branch:-main}
                    perform_switch "$main_branch"
                elif [[ "$1" =~ ^[0-9]+$ ]]; then
                    local branches=($(get_quiver))
                    local main_branch=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed "s|origin/||")
                    main_branch=${main_branch:-main}

                    local display_indices=()
                    for i in "${!branches[@]}"; do
                        [ "${branches[$i]}" == "$main_branch" ] && continue
                        display_indices+=("$i")
                    done

                    local display_idx=$(($1 - 1))
                    if [ "$display_idx" -ge 0 ] && [ "$display_idx" -lt "${#display_indices[@]}" ]; then
                        local array_idx="${display_indices[$display_idx]}"
                        perform_switch "${branches[$array_idx]}"
                    else
                        echo -e "${RED}Error: Index $1 out of range.${NC}"
                        exit 1
                    fi
                # Direct command invocation: git quiver ctx, git quiver pr 3, etc.
                elif is_quiver_command "$1"; then
                    local cmd="$1"
                    shift
                    run_quiver_command "$cmd" "$@"
                else
                    echo -e "${RED}Unknown: '$1'. Use --help.${NC}"
                    exit 1
                fi
                ;;
        esac
    }

    main "$@"
EOF
)

ESCAPED_CODE=$(echo "$SCRIPT_CONTENT" | sed "s/'/'\\\\''/g")

git config --global alias.quiver "!f() {
    bash -c '$ESCAPED_CODE' -- \"\$@\"
}; f"
