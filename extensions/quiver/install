#!/bin/bash

SCRIPT_CONTENT=$(cat <<'EOF'
    VERSION="1.1.0"
    GREEN="\033[0;32m"; YELLOW="\033[1;33m"; CYAN="\033[0;36m"; RED="\033[0;31m"; GRAY="\033[90m"; BOLD="\033[1m"; NC="\033[0m"

    if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
        echo -e "${RED}Error: Not in a git repository.${NC}"
        exit 1
    fi

    # --- Quiver commands registry ---
    # remote: can run targeting any branch without checkout
    QUIVER_CMDS_REMOTE="ctx pr"
    QUIVER_COMMANDS="$QUIVER_CMDS_REMOTE"

    get_quiver() {
        git config --local --get-all quiver.branch 2>/dev/null || echo ""
    }

    save_quiver() {
        git config --local --unset-all quiver.branch 2>/dev/null || true
        for branch in "$@"; do
            [ -n "$branch" ] && git config --local --add quiver.branch "$branch"
        done
    }

    get_current_stash_name() {
        local branch=$1
        local hash=$(git rev-parse --short HEAD)
        echo "$hash-quiver-stash-$branch"
    }

    manage_stash_push() {
        local branch=$(git branch --show-current)
        if [ -n "$(git status --porcelain)" ]; then
            local msg=$(get_current_stash_name "$branch")
            git stash push -m "$msg" > /dev/null
            echo -e "${YELLOW}Changes stashed.${NC}"
        fi
    }

    manage_stash_pop() {
        local branch=$1
        local msg=$(get_current_stash_name "$branch")
        local stash_id=$(git stash list | grep "$msg" | cut -d: -f1 | head -n 1 || true)
        if [ -n "$stash_id" ]; then
            git stash pop "$stash_id" > /dev/null
            echo -e "${YELLOW}Changes restored.${NC}"
        fi
    }

    help() {
        echo -e "${BOLD}${CYAN}git quiver v$VERSION${NC} — Interactive branch manager"
        echo ""
        echo -e "${YELLOW}Usage:${NC} git quiver [index | command | flags]"
        echo ""
        echo -e "${YELLOW}Flags:${NC}"
        echo "  -h, --help                Show this help page"
        echo "  -v, --version             Show version"
        echo "  -a, --add [branch]        Add branch to quiver (current if empty)"
        echo "  -r, --remove [index]      Remove branch from quiver by display index"
        echo "  -f, --filter [regexp]     Filter and pick from origin branches"
        echo "  -t, --top                 Move current branch to top of quiver"
        echo "  -b, --bottom              Move current branch to bottom of quiver"
        echo "  -m, --clean-merged        Remove merged branches from quiver"
        echo "  -e, --empty               Empty quiver"
        echo ""
        echo -e "${YELLOW}Interactive:${NC}"
        echo "  git quiver                Open interactive branch selector"
        echo "  git quiver [n]            Switch directly to branch at index n"
        echo "  git quiver f              Switch to default (main) branch"
        echo ""
        echo -e "${YELLOW}Commands (usable in interactive mode):${NC}"
        echo "  ctx [n]                   Show branch context (ticket + PR)"
        echo "  pr [n]                    Show/create pull request"
        echo ""
        echo -e "${GRAY}  [n] = optional branch index. Without it, runs on current branch.${NC}"
        echo -e "${GRAY}  Example: 'ctx 3' shows context of branch #3 without switching.${NC}"
    }

    is_quiver_command() {
        local input=$1
        for cmd in $QUIVER_COMMANDS; do
            [ "$cmd" = "$input" ] && return 0
        done
        return 1
    }

    run_quiver_command() {
        local cmd=$1
        shift
        local target_branch=""
        local run_all=false
        local cmd_args=""

        # Scan all args: extract . (all) or index, rest becomes cmd_args
        local remaining=()
        local index_found=""
        for arg in "$@"; do
            if [ "$arg" = "." ] && [ "$run_all" = false ] && [ -z "$index_found" ]; then
                run_all=true
            elif [[ "$arg" =~ ^[0-9]+$ ]] && [ "$run_all" = false ] && [ -z "$index_found" ]; then
                index_found="$arg"
            else
                remaining+=("$arg")
            fi
        done

        cmd_args="${remaining[*]}"

        # Resolve target branch from index
        if [ -n "$index_found" ]; then
            local idx=$((index_found - 1))
            local branches=($(get_quiver))
            local main_branch=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed "s|origin/||")
            main_branch=${main_branch:-main}

            local display_indices=()
            for i in "${!branches[@]}"; do
                [ "${branches[$i]}" == "$main_branch" ] && continue
                display_indices+=("$i")
            done

            if [ "$idx" -ge 0 ] && [ "$idx" -lt "${#display_indices[@]}" ]; then
                local array_idx="${display_indices[$idx]}"
                target_branch="${branches[$array_idx]}"
            else
                echo -e "  ${RED}Invalid index.${NC}"
                return 1
            fi
        fi

        if ! git config --global --get "alias.$cmd" > /dev/null 2>&1; then
            echo -e "  ${RED}'git $cmd' is not installed.${NC}"
            echo -e "  ${GRAY}Install via: git extension${NC}"
            return 1
        fi

        local current=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

        # Run on ALL branches
        if [ "$run_all" = true ]; then
            local branches=($(get_quiver))
            local main_branch=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed "s|origin/||")
            main_branch=${main_branch:-main}

            echo ""
            local display_num=1
            for i in "${!branches[@]}"; do
                local b="${branches[$i]}"
                [ "$b" == "$main_branch" ] && continue

                echo -e "  ${GRAY}[$display_num]${NC} ${b}"
                if [ "$b" = "$current" ]; then
                    git "$cmd" $cmd_args 2>/dev/null | grep -v "^$" | tail -n +2 | sed 's/^/      /'
                else
                    git checkout "$b" > /dev/null 2>&1
                    git "$cmd" $cmd_args 2>/dev/null | grep -v "^$" | tail -n +2 | sed 's/^/      /'
                    git checkout "$current" > /dev/null 2>&1
                fi
                display_num=$((display_num + 1))
            done
            echo ""
            return
        fi

        echo ""

        if [ -z "$target_branch" ] || [ "$target_branch" = "$current" ]; then
            echo -e "  ${CYAN}git $cmd $cmd_args${NC} ${GRAY}on ${current}${NC}"
            echo -e "  ${GRAY}─────────────────────────────────────────${NC}"
            git "$cmd" $cmd_args
            echo -e "  ${GRAY}─────────────────────────────────────────${NC}"
        else
            echo -e "  ${CYAN}git $cmd $cmd_args${NC} ${GRAY}on ${target_branch}${NC}"
            echo -e "  ${GRAY}─────────────────────────────────────────${NC}"
            git checkout "$target_branch" > /dev/null 2>&1
            git "$cmd" $cmd_args
            git checkout "$current" > /dev/null 2>&1
            echo -e "  ${GRAY}─────────────────────────────────────────${NC}"
        fi
    }

    perform_switch() {
        local target=$1
        local current=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

        if [ "$current" == "$target" ]; then
            echo -e "Already on ${GREEN}$target${NC}. Updating..."
            git fetch origin "$target" > /dev/null 2>&1 || true
            if ! git pull origin "$target" 2>&1; then
                echo -e "${RED}Pull failed. You may have conflicts or network issues.${NC}"
                return 1
            fi
            return 0
        fi

        manage_stash_push

        if ! git checkout "$target" > /dev/null 2>&1; then
            echo -e "${CYAN}Branch not found locally. Trying origin...${NC}"
            if ! git checkout --track "origin/$target" > /dev/null 2>&1; then
                echo -e "${RED}Error: Branch '$target' not found locally or on origin.${NC}"
                return 1
            fi
        fi

        echo -e "${CYAN}Updating $target...${NC}"
        git fetch origin "$target" > /dev/null 2>&1 || true

        local pull_output
        if ! pull_output=$(git pull origin "$target" 2>&1); then
            echo -e "${RED}Pull failed on $target:${NC}"
            echo "$pull_output"
            echo -e "${YELLOW}You may need to resolve conflicts manually.${NC}"
        fi

        echo -e "Switched to branch ${GREEN}$target${NC}"
        manage_stash_pop "$target"
    }

    quiver() {
        local branches=($(get_quiver))
        local current=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

        local main_branch=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed "s|origin/||")
        main_branch=${main_branch:-main}

        # Header
        echo ""
        echo -e "${BOLD}${CYAN}  quiver${NC} ${GRAY}— branch manager${NC}"
        echo -e "${GRAY}  ──────────────────────────────────────────${NC}"

        if [ ${#branches[@]} -eq 0 ] && [ -z "$main_branch" ]; then
            echo -e "  ${YELLOW}Empty. Use -a to add or -f to pick from origin.${NC}"
            return
        fi

        local current_in_quiver=false
        [ "$current" == "$main_branch" ] && current_in_quiver=true
        for b in "${branches[@]}"; do
            [ "$b" == "$current" ] && current_in_quiver=true
        done

        # Display main branch
        if [ "$current" == "$main_branch" ]; then
            echo -e "  ${GREEN}▸ f) $main_branch ${GRAY}(default)${NC}"
        else
            echo -e "    ${GRAY}f)${NC} $main_branch ${GRAY}(default)${NC}"
        fi

        # Display current branch if not in quiver
        if [ "$current_in_quiver" = false ]; then
            echo -e "  ${GREEN}▸    $current ${GRAY}(current — not in quiver)${NC}"
        fi

        # Display indexed branches
        local display_indices=()
        local display_number=1

        for i in "${!branches[@]}"; do
            local b="${branches[$i]}"
            [ "$b" == "$main_branch" ] && continue

            if [ "$current" == "$b" ]; then
                echo -e "  ${GREEN}▸ $display_number) $b${NC}"
            else
                echo -e "    ${GRAY}$display_number)${NC} $b"
            fi
            display_indices+=("$i")
            display_number=$((display_number + 1))
        done

        # Footer
        echo -e "${GRAY}  ──────────────────────────────────────────${NC}"
        echo -e "  ${GRAY}${#branches[@]} branches │ commands: ctx, pr${NC}"
        echo -e "  ${GRAY}[n] switch │ [cmd n] inspect branch │ [h] help${NC}"
        echo ""

        # Input
        local choice
        if [ "$current_in_quiver" = false ]; then
            read -p "  > " choice < /dev/tty
        else
            read -p "  > " choice < /dev/tty
        fi

        # Handle empty input
        [ -z "$choice" ] && return

        # Parse input: could be index, command, or action
        local first_word=$(echo "$choice" | awk '{print $1}')
        local rest_args=$(echo "$choice" | awk '{$1=""; print $0}' | sed 's/^ //')

        # Quit
        if [[ "$first_word" =~ ^[qQ]$ ]]; then
            return

        # Add current branch
        elif [[ "$first_word" =~ ^[aA]$ ]]; then
            local current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
            add_branch "$current_branch" "normal"

        # Switch to main
        elif [[ "$first_word" =~ ^[fF]$ ]]; then
            perform_switch "$main_branch"

        # Numeric: switch to branch
        elif [[ "$first_word" =~ ^[0-9]+$ ]]; then
            local display_idx=$((first_word - 1))
            if [ "$display_idx" -ge 0 ] && [ "$display_idx" -lt "${#display_indices[@]}" ]; then
                local array_idx="${display_indices[$display_idx]}"
                local target="${branches[$array_idx]}"
                perform_switch "$target"
            else
                echo -e "  ${RED}Invalid index.${NC}"
            fi

        # Quiver command
        elif is_quiver_command "$first_word"; then
            run_quiver_command "$first_word" $rest_args

        # Help shortcut
        elif [[ "$first_word" =~ ^[hH\?]$ ]]; then
            echo ""
            echo -e "  ${YELLOW}Actions:${NC}"
            echo -e "    ${CYAN}[n]${NC}          Switch to branch n"
            echo -e "    ${CYAN}f${NC}            Switch to main"
            echo -e "    ${CYAN}a${NC}            Add current branch to quiver"
            echo -e "    ${CYAN}q${NC}            Quit"
            echo ""
            echo -e "  ${YELLOW}Commands (inspect any branch):${NC}"
            echo -e "    ${CYAN}ctx${NC}          Context of current branch"
            echo -e "    ${CYAN}ctx 3${NC}        Context of branch #3"
            echo -e "    ${CYAN}pr${NC}           PR of current branch"
            echo -e "    ${CYAN}pr 2${NC}         PR of branch #2"
            echo ""

        else
            echo -e "  ${RED}Unknown: '$first_word'. Type 'h' for help.${NC}"
        fi
    }

    quiver_origin() {
        local regex=$1
        echo -e "${CYAN}Fetching branches from origin...${NC}"
        git fetch origin > /dev/null 2>&1

        local filter_pattern="${regex:-.*}"

        local filtered=($(git branch -r --no-color | grep "origin/" | grep -v "origin/HEAD" | sed 's|[[:space:]]*origin/||' | grep -iE -e "$filter_pattern"))

        if [ ${#filtered[@]} -eq 0 ]; then
            echo -e "${RED}No branches found matching: '$filter_pattern'${NC}"
            return
        fi

        echo ""
        local i=1
        for b in "${filtered[@]}"; do
            echo -e "    ${GRAY}$i)${NC} $b"
            i=$((i+1))
        done

        echo ""
        local choice
        read -p "  Select branch to add and switch: " choice < /dev/tty

        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#filtered[@]}" ]; then
            local target="${filtered[$((choice-1))]}"
            add_branch "$target" "normal"
            perform_switch "$target"
        else
            echo -e "${RED}Invalid choice.${NC}"
        fi
    }

    add_branch() {
        local target=${1:-$(git branch --show-current)}
        local pos=${2:-normal}
        local branches=($(get_quiver))

        for b in "${branches[@]}"; do
            if [ "$b" == "$target" ]; then
                echo -e "  ${YELLOW}'$target' already in quiver.${NC}"
                return
            fi
        done

        if [ "$pos" == "top" ]; then
            save_quiver "$target" "${branches[@]}"
        else
            save_quiver "${branches[@]}" "$target"
        fi
        echo -e "  ${GREEN}✓ Added '$target'${NC}"
    }

    remove_branch() {
        local target_display_index=$1
        local branches=($(get_quiver))

        if [[ -z "$target_display_index" ]] || [[ ! "$target_display_index" =~ ^[0-9]+$ ]]; then
            echo -e "${RED}Error: Provide a valid numeric index.${NC}"
            return 1
        fi

        local main_branch=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed "s|origin/||")
        main_branch=${main_branch:-main}

        local display_number=1
        local array_idx_to_remove=""

        for i in "${!branches[@]}"; do
            [ "${branches[$i]}" == "$main_branch" ] && continue
            if [ "$display_number" -eq "$target_display_index" ]; then
                array_idx_to_remove=$i
                break
            fi
            display_number=$((display_number + 1))
        done

        if [ -z "$array_idx_to_remove" ]; then
            echo -e "${RED}Error: Index $target_display_index out of range.${NC}"
            return 1
        fi

        local removed="${branches[$array_idx_to_remove]}"
        unset "branches[$array_idx_to_remove]"
        save_quiver "${branches[@]}"
        echo -e "  ${YELLOW}✗ Removed '$removed'${NC}"
    }

    clean_merged_branches() {
        local main_branch=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed "s|origin/||")
        main_branch=${main_branch:-main}

        echo -e "${CYAN}Fetching and pruning remote references...${NC}"
        git fetch origin --prune > /dev/null 2>&1 || true

        local branches=($(get_quiver))
        local kept_branches=()
        local removed_count=0
        local has_gh=false
        command -v gh > /dev/null 2>&1 && has_gh=true

        if [ "$has_gh" = false ]; then
            echo -e "  ${YELLOW}(gh CLI not found — squash-merge detection disabled)${NC}"
        fi

        local merged_list=$(git branch --merged "origin/$main_branch" 2>/dev/null | sed 's/^[* ]*//')

        for b in "${branches[@]}"; do
            if [ "$b" == "$main_branch" ]; then
                kept_branches+=("$b")
                continue
            fi

            local is_merged=false
            local reason=""

            if ! git rev-parse --verify "$b" > /dev/null 2>&1; then
                if ! git ls-remote --heads origin "$b" 2>/dev/null | grep -q "$b"; then
                    is_merged=true
                    reason="gone (local + remote)"
                else
                    kept_branches+=("$b")
                    continue
                fi
            elif git merge-base --is-ancestor "$b" "origin/$main_branch" 2>/dev/null; then
                is_merged=true
                reason="merged into $main_branch"
            elif echo "$merged_list" | grep -qxF "$b"; then
                is_merged=true
                reason="merged into $main_branch"
            elif ! git ls-remote --heads origin "$b" 2>/dev/null | grep -q "$b"; then
                is_merged=true
                reason="remote deleted"
            elif [ "$has_gh" = true ]; then
                local pr_state=$(gh pr list --head "$b" --state all --json state --jq '.[0].state' 2>/dev/null)
                if [ "$pr_state" = "MERGED" ] || [ "$pr_state" = "CLOSED" ]; then
                    is_merged=true
                    reason="PR $pr_state"
                fi
            fi

            if [ "$is_merged" = true ]; then
                echo -e "  ${RED}✗${NC} ${b} ${GRAY}(${reason})${NC}"
                removed_count=$((removed_count + 1))
            else
                kept_branches+=("$b")
            fi
        done

        save_quiver "${kept_branches[@]}"
        echo ""
        if [ $removed_count -eq 0 ]; then
            echo -e "  ${GREEN}No merged branches found.${NC}"
        else
            echo -e "  ${GREEN}✓ Removed $removed_count branch(es)${NC}"
        fi
    }

    reorder_branch() {
        local target=$(git branch --show-current)
        local pos=$1
        local branches=($(get_quiver))
        local new_branches=()

        for b in "${branches[@]}"; do
            [ "$b" != "$target" ] && new_branches+=("$b")
        done

        if [ "$pos" == "top" ]; then
            save_quiver "$target" "${new_branches[@]}"
        else
            save_quiver "${new_branches[@]}" "$target"
        fi
        echo -e "  ${GREEN}Moved '$target' to $pos.${NC}"
    }

    empty_quiver() {
        git config --local --unset-all quiver.branch 2>/dev/null || true
        echo -e "  ${YELLOW}Quiver emptied.${NC}"
    }

    main() {
        case "${1:-}" in
            -h|--help|help) help; exit 0 ;;
            -v|--version) echo "git quiver v$VERSION"; exit 0 ;;
            -a|--add)
                local branch=""
                if [[ -n "${2:-}" && "${2:-}" != -* ]]; then branch="$2"; fi
                add_branch "$branch" "normal"
                ;;
            -r|--remove)
                if [[ -n "${2:-}" ]]; then
                    remove_branch "$2"
                else
                    echo -e "${RED}Error: Provide an index.${NC}"
                    exit 1
                fi
                ;;
            -f|--filter)
                quiver_origin "${2:-}"
                ;;
            -t|--top) reorder_branch "top" ;;
            -b|--bottom) reorder_branch "bottom" ;;
            -m|--clean-merged) clean_merged_branches ;;
            -e|--empty) empty_quiver ;;
            *)
                if [ $# -eq 0 ]; then quiver; exit 0; fi

                if [[ "$1" =~ ^(f|F|fresh|FRESH)$ ]]; then
                    local main_branch=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed "s|origin/||")
                    main_branch=${main_branch:-main}
                    perform_switch "$main_branch"
                elif [[ "$1" =~ ^[0-9]+$ ]]; then
                    local branches=($(get_quiver))
                    local main_branch=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed "s|origin/||")
                    main_branch=${main_branch:-main}

                    local display_indices=()
                    for i in "${!branches[@]}"; do
                        [ "${branches[$i]}" == "$main_branch" ] && continue
                        display_indices+=("$i")
                    done

                    local display_idx=$(($1 - 1))
                    if [ "$display_idx" -ge 0 ] && [ "$display_idx" -lt "${#display_indices[@]}" ]; then
                        local array_idx="${display_indices[$display_idx]}"
                        perform_switch "${branches[$array_idx]}"
                    else
                        echo -e "${RED}Error: Index $1 out of range.${NC}"
                        exit 1
                    fi
                # Direct command invocation: git quiver ctx, git quiver pr 3, etc.
                elif is_quiver_command "$1"; then
                    local cmd="$1"
                    shift
                    run_quiver_command "$cmd" "$@"
                else
                    echo -e "${RED}Unknown: '$1'. Use --help.${NC}"
                    exit 1
                fi
                ;;
        esac
    }

    main "$@"
EOF
)

ESCAPED_CODE=$(echo "$SCRIPT_CONTENT" | sed "s/'/'\\\\''/g")

git config --global alias.quiver "!f() {
    bash -c '$ESCAPED_CODE' -- \"\$@\"
}; f"
