#!/bin/bash

SCRIPT_CONTENT=$(cat <<'EOF'
#!/bin/bash

VERSION="1.0.0"
GREEN="\033[0;32m"; YELLOW="\033[1;33m"; CYAN="\033[0;36m"; RED="\033[0;31m"; NC="\033[0m"

show_help() {
    echo -e "${CYAN}git sync${NC} — Fetch and rebase/merge the default branch onto the current branch"
    echo ""
    echo "Usage: git sync [options]"
    echo ""
    echo "Options:"
    echo "  -h, --help       Show this help message"
    echo "  -v, --version    Show version"
    echo "  -b <branch>      Sync with a specific branch instead of the default"
    echo "      --merge      Use merge instead of rebase"
}

USE_MERGE=false
TARGET_BRANCH=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) show_help; exit 0;;
        -v|--version) echo "git sync v$VERSION"; exit 0;;
        --merge) USE_MERGE=true; shift;;
        -b)
            if [[ -z "$2" || "$2" == -* ]]; then
                echo -e "${RED}Error: -b requires a branch name.${NC}"; exit 1
            fi
            TARGET_BRANCH="$2"; shift 2;;
        *)
            echo -e "${RED}Error: Unknown option '$1'. Use --help for usage.${NC}"; exit 1;;
    esac
done

if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    echo -e "${RED}Error: Not in a git repository.${NC}"; exit 1
fi

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [[ -z "$TARGET_BRANCH" ]]; then
    if git rev-parse --verify origin/main > /dev/null 2>&1; then
        TARGET_BRANCH="main"
    elif git rev-parse --verify origin/master > /dev/null 2>&1; then
        TARGET_BRANCH="master"
    else
        echo -e "${RED}Error: Could not detect default branch (neither origin/main nor origin/master exist).${NC}"
        exit 1
    fi
fi

echo -e "${CYAN}Fetching from origin...${NC}"
if ! git fetch origin; then
    echo -e "${RED}Error: Failed to fetch from origin.${NC}"; exit 1
fi

STASHED=false
if ! git diff --quiet || ! git diff --cached --quiet; then
    echo -e "${YELLOW}Stashing uncommitted changes...${NC}"
    git stash push -m "git-sync: auto-stash before sync" > /dev/null 2>&1
    STASHED=true
fi

if [[ "$USE_MERGE" == true ]]; then
    echo -e "${CYAN}Merging origin/${TARGET_BRANCH} into ${CURRENT_BRANCH}...${NC}"
    if git merge "origin/${TARGET_BRANCH}"; then
        echo -e "${GREEN}✔ Successfully merged origin/${TARGET_BRANCH} into ${CURRENT_BRANCH}.${NC}"
    else
        echo -e "${RED}✖ Merge conflict detected.${NC}"
        echo -e "${YELLOW}Resolve conflicts and then run:${NC}"
        echo -e "  git add <resolved-files>"
        echo -e "  git commit"
        echo -e ""
        echo -e "${YELLOW}Or abort the merge with:${NC}"
        echo -e "  git merge --abort"
        if [[ "$STASHED" == true ]]; then
            echo -e ""
            echo -e "${YELLOW}Note: You have stashed changes. Run 'git stash pop' after resolving.${NC}"
        fi
        exit 1
    fi
else
    echo -e "${CYAN}Rebasing ${CURRENT_BRANCH} onto origin/${TARGET_BRANCH}...${NC}"
    if git rebase "origin/${TARGET_BRANCH}"; then
        echo -e "${GREEN}✔ Successfully rebased ${CURRENT_BRANCH} onto origin/${TARGET_BRANCH}.${NC}"
    else
        echo -e "${RED}✖ Rebase conflict detected.${NC}"
        echo -e "${YELLOW}To resolve:${NC}"
        echo -e "  1. Fix the conflicts in the listed files"
        echo -e "  2. git add <resolved-files>"
        echo -e "  3. git rebase --continue"
        echo -e ""
        echo -e "${YELLOW}Or abort the rebase with:${NC}"
        echo -e "  git rebase --abort"
        if [[ "$STASHED" == true ]]; then
            echo -e ""
            echo -e "${YELLOW}Note: You have stashed changes. Run 'git stash pop' after resolving.${NC}"
        fi
        exit 1
    fi
fi

if [[ "$STASHED" == true ]]; then
    echo -e "${CYAN}Restoring stashed changes...${NC}"
    if git stash pop > /dev/null 2>&1; then
        echo -e "${GREEN}✔ Stashed changes restored.${NC}"
    else
        echo -e "${YELLOW}⚠ Could not cleanly restore stashed changes. Use 'git stash show' and 'git stash pop' manually.${NC}"
    fi
fi
EOF
)

ESCAPED_CODE=$(echo "$SCRIPT_CONTENT" | sed "s/'/'\\\\''/g")

git config --global alias.sync "!f() {
    bash -c '$ESCAPED_CODE' -- \"\$@\"
}; f"
