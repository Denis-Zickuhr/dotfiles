#!/bin/bash

SCRIPT_CONTENT=$(cat <<'EOF'
    VERSION="1.1.0"
    GREEN="\033[0;32m"; YELLOW="\033[1;33m"; CYAN="\033[0;36m"; RED="\033[0;31m"; GRAY="\033[90m"; NC="\033[0m"

    show_help() {
      echo -e "${CYAN}git cbn v$VERSION${NC}"
      echo ""
      echo "Commit with message auto-generated from branch name."
      echo "Supports scoped commits for monorepos."
      echo ""
      echo -e "${YELLOW}Usage:${NC} git cbn [options]"
      echo ""
      echo -e "${YELLOW}Options:${NC}"
      echo "  -m, --message <msg>    Custom commit message body"
      echo "  -s, --scope <scope>    Force a specific scope"
      echo "  -op, --omit-prefix     Omit the prefix (ticket) from the commit"
      echo "  --no-scope             Disable scope detection"
      echo "  -h, --help             Show help"
      echo "  -v, --version          Show version"
      echo ""
      echo -e "${YELLOW}Scope detection (in order):${NC}"
      echo "  1. --scope flag (manual)"
      echo "  2. Staged files (if all in same top-level dir)"
      echo "  3. Branch name (if contains a known dir name)"
      echo ""
      echo -e "${YELLOW}Examples:${NC}"
      echo "  Branch: MAG-123-feat-ajuste-bling     → MAG-123 - feat(bling): ajuste"
      echo "  Branch: feat-global-logging           → feat(global): logging"
      echo "  Branch: MAG-456-fix-correcoes-padrao  → MAG-456 - fix: correcoes padrao"
      echo "    (no scope if files span multiple dirs)"
    }

    error_exit() {
      echo -e "${RED}Error: $1${NC}" >&2
      return 1
    }

    if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
      echo -e "${RED}Error: Not in a git repository.${NC}"; exit 1
    fi

    # --- Scope detection ---

    detect_scope_from_files() {
        # Check staged files — if all share the same top-level directory, that's the scope
        # If multiple dirs and repo has a "global/" dir (monorepo pattern), scope = "global"
        local staged=$(git diff --cached --name-only 2>/dev/null)
        [ -z "$staged" ] && return

        local dirs=$(echo "$staged" | grep "/" | cut -d/ -f1 | sort -u)
        local dir_count=$(echo "$dirs" | grep -c . 2>/dev/null)

        if [ "$dir_count" -eq 1 ]; then
            local scope_dir=$(echo "$dirs" | head -1)
            if [ -d "$scope_dir" ]; then
                echo "$scope_dir"
            fi
        elif [ "$dir_count" -gt 1 ] && [ -d "global" ]; then
            echo "global"
        fi
    }

    detect_scope_from_branch() {
        local branch=$1
        # Get list of top-level directories as possible scopes
        local known_scopes=$(ls -d */ 2>/dev/null | sed 's|/||')
        [ -z "$known_scopes" ] && return

        # Check if any scope name appears in the branch name
        for scope in $known_scopes; do
            if echo "$branch" | grep -qiE "(^|[-/])${scope}([-/]|$)"; then
                echo "$scope"
                return
            fi
        done
    }

    # --- Parse args ---

    CT="feat|fix|chore|docs|style|refactor|perf|test|build|ci|revert"
    CUSTOM_MESSAGE=""
    OMIT_PREFIX=false
    FORCED_SCOPE=""
    NO_SCOPE=false

    while [ $# -gt 0 ]; do
      case "$1" in
        -h|--help) show_help; exit 0;;
        -v|--version) echo "git cbn v$VERSION"; exit 0;;
        -m|--message)
          if [ -z "$2" ]; then
            error_exit "The '$1' flag requires a message."; exit 1
          fi
          CUSTOM_MESSAGE="$2"; shift; shift;;
        -s|--scope)
          if [ -z "$2" ]; then
            error_exit "The '$1' flag requires a scope."; exit 1
          fi
          FORCED_SCOPE="$2"; shift; shift;;
        -op|--omit-prefix) OMIT_PREFIX=true; shift;;
        --no-scope) NO_SCOPE=true; shift;;
        *) error_exit "Unknown option: $1"; exit 1;;
      esac
    done

    # --- Resolve branch info ---

    BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)
    if [ -z "$BRANCH_NAME" ]; then
      error_exit "Could not determine branch name."; exit 1
    fi

    COMMIT_TYPE=$(echo "$BRANCH_NAME" | grep -oE "(^|[-/])(${CT})([-/])" | grep -oE "${CT}" | head -n 1)
    if [ -z "$COMMIT_TYPE" ]; then
      error_exit "No conventional commit type found in branch '${BRANCH_NAME}'."; exit 1
    fi

    # Extract prefix and description
    case "$BRANCH_NAME" in
      *-${COMMIT_TYPE}-*)
        PREFIX=$(echo "$BRANCH_NAME" | sed "s/-${COMMIT_TYPE}-.*//")
        DESCRIPTION=$(echo "$BRANCH_NAME" | sed "s/.*-${COMMIT_TYPE}-//")
        ;;
      */${COMMIT_TYPE}-*)
        PREFIX=$(echo "$BRANCH_NAME" | sed "s/\/${COMMIT_TYPE}-.*//")
        DESCRIPTION=$(echo "$BRANCH_NAME" | sed "s/.*\/${COMMIT_TYPE}-//")
        ;;
      ${COMMIT_TYPE}-*)
        PREFIX=""
        DESCRIPTION=$(echo "$BRANCH_NAME" | sed "s/^${COMMIT_TYPE}-//")
        ;;
      *)
        error_exit "Branch format invalid. Use '[PREFIX-]<type>-<desc>'."; exit 1
        ;;
    esac

    # --- Resolve scope ---

    SCOPE=""
    if [ "$NO_SCOPE" = false ]; then
        if [ -n "$FORCED_SCOPE" ]; then
            SCOPE="$FORCED_SCOPE"
        else
            # Try files first
            SCOPE=$(detect_scope_from_files)
            # Fallback: branch name
            if [ -z "$SCOPE" ]; then
                SCOPE=$(detect_scope_from_branch "$BRANCH_NAME")
            fi
        fi

        # Remove scope from description if present (avoid "feat(bling): ajuste bling")
        if [ -n "$SCOPE" ]; then
            DESCRIPTION=$(echo "$DESCRIPTION" | sed -E "s/(^|-)${SCOPE}(-|$)/\1/;s/^-//;s/-$//;s/--/-/g")
        fi
    fi

    # --- Build message ---

    DESCRIPTION=$(echo "$DESCRIPTION" | sed "s/[-_]/ /g" | sed 's/^ *//;s/ *$//')

    if [ -n "$CUSTOM_MESSAGE" ]; then
      MSG_BODY="$CUSTOM_MESSAGE"
    elif [ -z "$DESCRIPTION" ]; then
      error_exit "Branch name must include a description after the type."; exit 1
    else
      MSG_BODY="$DESCRIPTION"
    fi

    # Build type with optional scope
    if [ -n "$SCOPE" ]; then
        TYPE_PART="${COMMIT_TYPE}(${SCOPE})"
    else
        TYPE_PART="${COMMIT_TYPE}"
    fi

    COMMIT_PREFIX=""
    if [ -n "$PREFIX" ] && [ "$OMIT_PREFIX" = false ]; then
      COMMIT_PREFIX="${PREFIX} - "
    fi

    COMMIT_MESSAGE="${COMMIT_PREFIX}${TYPE_PART}: ${MSG_BODY}"
    echo -e "${GREEN}Running:${NC} git commit -m \"${CYAN}${COMMIT_MESSAGE}${NC}\""
    git commit -m "$COMMIT_MESSAGE"
EOF
)

ESCAPED_CODE=$(echo "$SCRIPT_CONTENT" | sed "s/'/'\\\\''/g")

git config --global alias.cbn "!f() {
    bash -c '$ESCAPED_CODE' -- \"\$@\"
}; f"
