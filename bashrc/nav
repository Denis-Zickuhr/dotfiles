# ─── Entry point ──────────────────────────────────────────────────────────────

nav() {
    __nav_ensure_aliases
    __nav_ensure_config
    __nav_ensure_usage
    __nav_ensure_frecent

    if [[ $# -eq 0 ]]; then
        __nav_interactive cd "" smart
        return $?
    fi

    case "$1" in
        set)      shift; __nav_set "$@" ;;
        unset)    shift; __nav_unset "$@" ;;
        list)     __nav_list ;;
        prune)    shift; __nav_prune "$@" ;;
        export)   shift; __nav_export "$@" ;;
        import)   shift; __nav_import "$@" ;;
        config)   shift; __nav_config "$@" ;;
        usage)    shift; __nav_usage_cmd "$@" ;;
        learned)  shift; __nav_learned_cmd "$@" ;;
        -o)       shift; __nav_interactive open "$1" smart ;;
        -p)       __nav_interactive print "" smart ;;
        i|interactive) shift; __nav_interactive_dispatch all "$@" ;;
        o|opener)      shift; __nav_interactive open "$1" smart ;;
        p|print)       __nav_interactive print "" smart ;;
        f|frequent)    shift; __nav_interactive_dispatch learned "$@" ;;
        help|--help|-h) __nav_help ;;
        *)        __nav_goto "$@" ;;
    esac
}

# ─── Tab completion ───────────────────────────────────────────────────────────

__nav_complete() {
    local cur prev top
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    top="${COMP_WORDS[1]}"

    __nav_ensure_aliases
    local aliases
    aliases=$(cut -d'=' -f1 "$NAV_ALIASES_FILE" 2>/dev/null)

    local subcommands="set unset list prune export import config usage learned interactive i opener o print p frequent f help -o -p"

    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "${subcommands} ${aliases}" -- "$cur") )
        return 0
    fi

    case "$top" in
        unset)
            COMPREPLY=( $(compgen -W "${aliases}" -- "$cur") )
            ;;
        set)
            COMPREPLY=( $(compgen -W "--alias --path" -- "$cur") )
            ;;
        import)
            COMPREPLY=( $(compgen -f -- "$cur") )
            ;;
        export)
            COMPREPLY=( $(compgen -W "--name" -- "$cur") )
            ;;
        prune)
            COMPREPLY=( $(compgen -W "-y --yes" -- "$cur") )
            ;;
        usage|learned)
            COMPREPLY=( $(compgen -W "show clear" -- "$cur") )
            ;;
        config)
            if [[ $COMP_CWORD -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "opener openers page_size track show" -- "$cur") )
            elif [[ "${COMP_WORDS[2]}" == "openers" && $COMP_CWORD -eq 3 ]]; then
                COMPREPLY=( $(compgen -W "add remove list" -- "$cur") )
            elif [[ "${COMP_WORDS[2]}" == "opener" && $COMP_CWORD -eq 3 ]]; then
                COMPREPLY=( $(compgen -W "ASK explorer.exe" -- "$cur") )
            elif [[ "${COMP_WORDS[2]}" == "track" && $COMP_CWORD -eq 3 ]]; then
                COMPREPLY=( $(compgen -W "on off" -- "$cur") )
            fi
            ;;
        *)
            # `nav <alias> ...` — an alias was typed in position 1, offer flags next
            if [[ $COMP_CWORD -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "-o -p -x" -- "$cur") )
            fi
            ;;
    esac

    return 0
}

if [[ -n "$BASH_VERSION" ]] && command -v complete >/dev/null 2>&1; then
    complete -F __nav_complete nav
fi
