#!/bin/bash
# nav - A simple navigation manager
# Oriented to functions

NAV_ALIASES_FILE="$HOME/.navm_aliases"
NAV_CONFIG_FILE="$HOME/.navm_config"
NAV_USAGE_FILE="$HOME/.navm_usage"
NAV_FRECENT_FILE="$HOME/.navm_frecent"
NAV_FRECENT_MAX=500

# ─── Config helpers ───────────────────────────────────────────────────────────

__nav_ensure_aliases() {
    touch "$NAV_ALIASES_FILE"
}

__nav_ensure_config() {
    if [ ! -f "$NAV_CONFIG_FILE" ]; then
        printf "opener=explorer.exe\n[openers]\n" > "$NAV_CONFIG_FILE"
    fi
}

__nav_ensure_usage() {
    touch "$NAV_USAGE_FILE"
}

__nav_ensure_frecent() {
    touch "$NAV_FRECENT_FILE"
}

__nav_config_get_page_size() {
    local n
    n=$(grep "^page_size=" "$NAV_CONFIG_FILE" 2>/dev/null | cut -d'=' -f2-)
    if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -gt 0 ]; then
        echo "$n"
    else
        echo 10
    fi
}

__nav_config_set_page_size() {
    local value="$1"

    if ! [[ "$value" =~ ^[0-9]+$ ]] || [ "$value" -lt 1 ]; then
        echo "Error: page size must be a positive integer." >&2
        return 1
    fi

    if grep -q "^page_size=" "$NAV_CONFIG_FILE" 2>/dev/null; then
        sed -i "s|^page_size=.*|page_size=${value}|" "$NAV_CONFIG_FILE"
    else
        sed -i "1i page_size=${value}" "$NAV_CONFIG_FILE"
    fi
    echo "Page size set to '${value}'."
}

__nav_config_get_opener() {
    local opener
    opener=$(grep "^opener=" "$NAV_CONFIG_FILE" 2>/dev/null | cut -d'=' -f2-)
    echo "${opener:-explorer.exe}"
}

__nav_config_set_opener() {
    local value="$1"

    if grep -q "^opener=" "$NAV_CONFIG_FILE" 2>/dev/null; then
        sed -i "s|^opener=.*|opener=${value}|" "$NAV_CONFIG_FILE"
    else
        sed -i "1i opener=${value}" "$NAV_CONFIG_FILE"
    fi
    echo "Opener set to '${value}'."
}

__nav_config_get_openers() {
    # Returns lines after [openers] marker
    sed -n '/^\[openers\]$/,$ { /^\[openers\]$/d; p }' "$NAV_CONFIG_FILE" 2>/dev/null
}

__nav_config_openers_list() {
    local openers
    openers=$(__nav_config_get_openers)

    if [ -z "$openers" ]; then
        echo "No openers configured."
        return 1
    fi

    echo "Configured openers:"
    local i=1
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        local desc="${line%% - *}"
        printf "  [%d] %s\n" "$i" "$desc"
        i=$((i + 1))
    done <<< "$openers"
}

__nav_config_openers_add() {
    local entry="$1"

    if [ -z "$entry" ]; then
        echo "Usage: nav config openers add \"<desc> - <command>\"" >&2
        return 1
    fi

    # Validate format
    if [[ "$entry" != *" - "* ]]; then
        echo "Error: Format must be \"<desc> - <command>\"." >&2
        return 1
    fi

    # Ensure [openers] section exists
    if ! grep -q "^\[openers\]$" "$NAV_CONFIG_FILE" 2>/dev/null; then
        echo "[openers]" >> "$NAV_CONFIG_FILE"
    fi

    echo "$entry" >> "$NAV_CONFIG_FILE"
    echo "Opener added: ${entry}"
}

__nav_config_openers_remove() {
    local num="$1"

    if [ -z "$num" ] || ! [[ "$num" =~ ^[0-9]+$ ]]; then
        echo "Usage: nav config openers remove <number>" >&2
        return 1
    fi

    local openers
    openers=$(__nav_config_get_openers)

    if [ -z "$openers" ]; then
        echo "No openers configured." >&2
        return 1
    fi

    local count=0
    local target_line=""
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        count=$((count + 1))
        if [ "$count" -eq "$num" ]; then
            target_line="$line"
            break
        fi
    done <<< "$openers"

    if [ -z "$target_line" ]; then
        echo "Error: Invalid number. Use 'nav config openers list' to see available options." >&2
        return 1
    fi

    # Escape special characters for sed
    local escaped
    escaped=$(printf '%s\n' "$target_line" | sed 's/[[\.*^$()+?{|]/\\&/g')
    sed -i "/^${escaped}$/d" "$NAV_CONFIG_FILE"
    echo "Removed: ${target_line}"
}

__nav_config_get_track() {
    local v
    v=$(grep "^track=" "$NAV_CONFIG_FILE" 2>/dev/null | cut -d'=' -f2-)
    case "$v" in
        off) echo "off" ;;
        *)   echo "on" ;;
    esac
}

__nav_config_set_track() {
    local value="$1"
    case "$value" in
        on|off) ;;
        *)
            echo "Error: track must be 'on' or 'off'." >&2
            return 1
            ;;
    esac

    if grep -q "^track=" "$NAV_CONFIG_FILE" 2>/dev/null; then
        sed -i "s|^track=.*|track=${value}|" "$NAV_CONFIG_FILE"
    else
        sed -i "1i track=${value}" "$NAV_CONFIG_FILE"
    fi
    echo "Directory tracking set to '${value}'."
}

__nav_config_show() {
    echo "─── NAV Configuration ───"
    echo ""
    echo "  Opener: $(__nav_config_get_opener)"
    echo "  Interactive page size: $(__nav_config_get_page_size)"
    echo "  Directory tracking (nav f): $(__nav_config_get_track)"
    echo ""

    local openers
    openers=$(__nav_config_get_openers)

    if [ -n "$openers" ]; then
        echo "  Openers list (ASK mode):"
        local i=1
        while IFS= read -r line; do
            [ -z "$line" ] && continue
            local desc="${line%% - *}"
            local cmd="${line##* - }"
            printf "    [%d] %s (%s)\n" "$i" "$desc" "$cmd"
            i=$((i + 1))
        done <<< "$openers"
    else
        echo "  Openers list: (empty)"
    fi
    echo ""
}

__nav_config() {
    case "$1" in
        opener)
            if [ -z "$2" ]; then
                echo "Current opener: $(__nav_config_get_opener)"
            else
                __nav_config_set_opener "$2"
            fi
            ;;
        openers)
            case "$2" in
                add)    shift 2; __nav_config_openers_add "$*" ;;
                remove) __nav_config_openers_remove "$3" ;;
                list)   __nav_config_openers_list ;;
                *)
                    echo "Usage: nav config openers <add|remove|list>" >&2
                    return 1
                    ;;
            esac
            ;;
        page_size)
            if [ -z "$2" ]; then
                echo "Current page size: $(__nav_config_get_page_size)"
            else
                __nav_config_set_page_size "$2"
            fi
            ;;
        track)
            if [ -z "$2" ]; then
                echo "Current tracking: $(__nav_config_get_track)"
            else
                __nav_config_set_track "$2"
            fi
            ;;
        show)
            __nav_config_show
            ;;
        *)
            echo "Usage: nav config <opener|openers|page_size|track|show>" >&2
            echo ""
            echo "  nav config opener [<cmd|ASK>]       Show or set the default opener"
            echo "  nav config openers add \"d - c\"      Add opener to ASK list"
            echo "  nav config openers remove <num>     Remove opener by number"
            echo "  nav config openers list             List configured openers"
            echo "  nav config page_size [<n>]          Show or set interactive mode page size"
            echo "  nav config track [<on|off>]         Show or set directory auto-tracking (nav f)"
            echo "  nav config show                     Show full configuration"
            return 1
            ;;
    esac
}

# ─── Usage tracking (alias frecency) ───────────────────────────────────────────
#
# Every successful `cd`/open/exec against an *alias* bumps a counter and
# timestamp in ~/.navm_usage (format: alias=count:epoch). Interactive mode
# uses this to rank aliases by "frecency" (frequency, recency as tiebreak)
# instead of raw file order. `-p`/print is intentionally NOT tracked here —
# it's meant for scripting/lookups, not "visiting" a place.

__nav_track_usage() {
    local alias="$1"
    [ -z "$alias" ] && return
    __nav_ensure_usage

    local now count
    now=$(date +%s)
    count=$(grep "^${alias}=" "$NAV_USAGE_FILE" 2>/dev/null | cut -d'=' -f2- | cut -d':' -f1)

    if [ -n "$count" ]; then
        count=$((count + 1))
        sed -i "s|^${alias}=.*|${alias}=${count}:${now}|" "$NAV_USAGE_FILE"
    else
        echo "${alias}=1:${now}" >> "$NAV_USAGE_FILE"
    fi
}

__nav_usage_get() {
    # Echoes "count:epoch" for the given alias, or "0:0" if never used.
    local alias="$1" line
    line=$(grep "^${alias}=" "$NAV_USAGE_FILE" 2>/dev/null | cut -d'=' -f2-)
    echo "${line:-0:0}"
}

__nav_usage_cmd() {
    __nav_ensure_usage
    case "$1" in
        show|"")
            if [ -s "$NAV_USAGE_FILE" ]; then
                echo "Alias usage stats:"
                local alias rest count epoch when
                while IFS='=' read -r alias rest; do
                    [ -z "$alias" ] && continue
                    count="${rest%%:*}"
                    epoch="${rest##*:}"
                    when=$(date -d "@${epoch}" '+%Y-%m-%d %H:%M' 2>/dev/null)
                    [ -z "$when" ] && when="-"
                    printf '%s\t%s uses\tlast: %s\n' "$alias" "$count" "$when"
                done < "$NAV_USAGE_FILE" | column -t -s $'\t'
            else
                echo "No usage data yet."
            fi
            ;;
        clear)
            : > "$NAV_USAGE_FILE"
            echo "Usage stats cleared."
            ;;
        *)
            echo "Usage: nav usage <show|clear>" >&2
            return 1
            ;;
    esac
}

# ─── Directory learning (auto-tracked paths, "nav f") ──────────────────────────
#
# Separate from alias usage: ~/.navm_frecent (format: count<TAB>epoch<TAB>path)
# records every directory actually `cd`'d into via the `cd` hook below —
# whether you got there through a nav alias, `nav f` itself, or a plain `cd`
# typed by hand. `nav f`/`frequent` picks from this history directly, no
# `nav set` required — it's the "learns the paths for you" mode. Opening a
# path (`-o`) also counts as a visit; printing (`-p`) does not. $HOME and `/`
# are skipped as too generic to be useful here. The file is capped at
# $NAV_FRECENT_MAX lines (keeping the highest-scoring ones) so it can't grow
# unbounded from years of `cd` calls.

__nav_track_path() {
    local path="$1"
    [ -z "$path" ] && return
    [ "$path" = "$HOME" ] && return
    [ "$path" = "/" ] && return
    __nav_ensure_frecent

    local now tmp
    now=$(date +%s)
    tmp=$(mktemp "${NAV_FRECENT_FILE}.XXXXXX" 2>/dev/null) || return

    local found=0 cnt epoch p
    while IFS=$'\t' read -r cnt epoch p || [ -n "$p" ]; do
        [ -z "$p" ] && continue
        if [ "$p" = "$path" ]; then
            cnt=$((cnt + 1))
            epoch="$now"
            found=1
        fi
        printf '%s\t%s\t%s\n' "$cnt" "$epoch" "$p"
    done < "$NAV_FRECENT_FILE" > "$tmp"

    [ "$found" -eq 0 ] && printf '1\t%s\t%s\n' "$now" "$path" >> "$tmp"

    if [ "$(wc -l < "$tmp" 2>/dev/null || echo 0)" -gt "$NAV_FRECENT_MAX" ]; then
        sort -t $'\t' -k1,1nr -k2,2nr "$tmp" | head -n "$NAV_FRECENT_MAX" > "${tmp}.capped" \
            && mv "${tmp}.capped" "$tmp"
    fi

    mv "$tmp" "$NAV_FRECENT_FILE"
}

__nav_untrack_path() {
    local path="$1"
    [ -z "$path" ] && return
    __nav_ensure_frecent

    local tmp
    tmp=$(mktemp "${NAV_FRECENT_FILE}.XXXXXX" 2>/dev/null) || return

    local cnt epoch p
    while IFS=$'\t' read -r cnt epoch p || [ -n "$p" ]; do
        [ -z "$p" ] && continue
        [ "$p" = "$path" ] && continue
        printf '%s\t%s\t%s\n' "$cnt" "$epoch" "$p"
    done < "$NAV_FRECENT_FILE" > "$tmp"

    mv "$tmp" "$NAV_FRECENT_FILE"
}

__nav_learned_cmd() {
    __nav_ensure_frecent
    case "$1" in
        show|"")
            if [ -s "$NAV_FRECENT_FILE" ]; then
                echo "Learned paths (auto-tracked via cd):"
                local cnt epoch p when disp
                while IFS=$'\t' read -r cnt epoch p; do
                    [ -z "$p" ] && continue
                    when=$(date -d "@${epoch}" '+%Y-%m-%d %H:%M' 2>/dev/null)
                    [ -z "$when" ] && when="-"
                    disp=$(__nav_display_path "$p")
                    printf '%s\t%s visits\tlast: %s\n' "$disp" "$cnt" "$when"
                done < <(sort -t $'\t' -k1,1nr -k2,2nr "$NAV_FRECENT_FILE") | column -t -s $'\t'
            else
                echo "No learned paths yet."
            fi
            ;;
        clear)
            : > "$NAV_FRECENT_FILE"
            echo "Learned paths cleared."
            ;;
        *)
            echo "Usage: nav learned <show|clear>" >&2
            return 1
            ;;
    esac
}

# ─── Display helpers ────────────────────────────────────────────────────────────

__nav_display_path() {
    # Shortens $HOME to ~ for display only — stored/resolved paths stay absolute.
    local p="$1"
    if [ -n "$HOME" ] && [[ "$p" == "$HOME"* ]]; then
        printf '~%s' "${p#"$HOME"}"
    else
        printf '%s' "$p"
    fi
}

# ─── ASK mode ─────────────────────────────────────────────────────────────────

__nav_ask_opener() {
    local path="$1"
    local openers
    openers=$(__nav_config_get_openers)

    if [ -z "$openers" ]; then
        echo "Error: No openers configured. Add openers with 'nav config openers add'." >&2
        return 1
    fi

    # Build arrays
    local descs=()
    local cmds=()
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        descs+=("${line%% - *}")
        cmds+=("${line##* - }")
    done <<< "$openers"

    if [ ${#descs[@]} -eq 0 ]; then
        echo "Error: No openers configured." >&2
        return 1
    fi

    # Display menu
    local i
    for i in "${!descs[@]}"; do
        printf "  [%d] %s\n" "$((i + 1))" "${descs[$i]}"
    done
    printf "  Escolha: "

    local choice
    read -r choice

    if [ -z "$choice" ] || ! [[ "$choice" =~ ^[0-9]+$ ]]; then
        echo "Cancelled." >&2
        return 1
    fi

    if [ "$choice" -lt 1 ] || [ "$choice" -gt ${#cmds[@]} ]; then
        echo "Error: Invalid choice." >&2
        return 1
    fi

    local selected_cmd="${cmds[$((choice - 1))]}"
    __nav_exec_opener "$selected_cmd" "$path"
}

# ─── Open logic ───────────────────────────────────────────────────────────────

__nav_exec_opener() {
    local cmd="$1"
    local path="$2"

    # Detect environment: if command ends with .exe, convert path for WSL
    if [[ "$cmd" == *.exe ]]; then
        local converted_path
        converted_path=$(wslpath -w "$path" 2>/dev/null || echo "$path")
        "$cmd" "$converted_path"
    else
        "$cmd" "$path"
    fi

    # GUI openers (explorer.exe and friends) routinely report a non-zero exit
    # code under WSL even though the window opened fine; propagating that
    # made callers/readers treat a successful `-o` as a failure/skip. The
    # open was fired, so report success regardless of the opener's own status.
    return 0
}

__nav_open() {
    local path="$1"
    local override="$2"

    # If explicit override was passed, use it directly
    if [ -n "$override" ]; then
        __nav_exec_opener "$override" "$path"
        return $?
    fi

    # Read from config
    local opener
    opener=$(__nav_config_get_opener)

    if [ "$opener" == "ASK" ]; then
        __nav_ask_opener "$path"
    else
        __nav_exec_opener "$opener" "$path"
    fi
}

# ─── Alias management ─────────────────────────────────────────────────────────

__nav_resolve_alias() {
    local alias="$1"
    grep "^${alias}=" "$NAV_ALIASES_FILE" | cut -d'=' -f2-
}

__nav_set() {
    local alias="" path="" have_path=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --alias)
                alias="$2"
                shift 2
                ;;
            --path)
                path="$2"
                have_path=1
                shift 2
                ;;
            *)
                echo "Usage: nav set [--alias <alias_name>] [--path <directory_path>]" >&2
                return 1
                ;;
        esac
    done

    if [ "$have_path" -eq 1 ]; then
        if [ -z "$path" ]; then
            echo "Usage: nav set [--alias <alias_name>] [--path <directory_path>]" >&2
            return 1
        fi
        path=$(realpath "$path" 2>/dev/null)
    else
        path=$(pwd)
    fi

    if [ -z "$path" ] || [ ! -d "$path" ]; then
        echo "Error: Path '$path' does not exist or is not a directory." >&2
        return 1
    fi

    # No --alias given: derive one from the folder name (kept backward
    # compatible — `--alias` still works exactly as before, this only fills
    # in when it's omitted). Collides with a *different* existing path get a
    # numeric suffix instead of silently overwriting it.
    if [ -z "$alias" ]; then
        local base
        base=$(basename "$path")
        alias=$(printf '%s' "$base" | tr -c 'A-Za-z0-9_.-' '-')
        [ -z "$alias" ] && alias="dir"

        if grep -q "^${alias}=" "$NAV_ALIASES_FILE" 2>/dev/null; then
            local existing
            existing=$(__nav_resolve_alias "$alias")
            if [ "$existing" != "$path" ]; then
                local n=2
                while grep -q "^${alias}${n}=" "$NAV_ALIASES_FILE" 2>/dev/null; do
                    n=$((n + 1))
                done
                alias="${alias}${n}"
            fi
        fi
    fi

    if grep -q "^${alias}=" "$NAV_ALIASES_FILE"; then
        sed -i "s|^${alias}=.*|${alias}=${path}|" "$NAV_ALIASES_FILE"
        echo "Updated alias '${alias}' to '${path}'."
    else
        echo "${alias}=${path}" >> "$NAV_ALIASES_FILE"
        echo "Set alias '${alias}' to '${path}'."
    fi
}

__nav_unset() {
    if [ -z "$1" ]; then
        echo "Usage: nav unset <alias_name>" >&2
        return 1
    fi

    local alias="$1"

    if grep -q "^${alias}=" "$NAV_ALIASES_FILE"; then
        sed -i "/^${alias}=/d" "$NAV_ALIASES_FILE"
        sed -i "/^${alias}=/d" "$NAV_USAGE_FILE" 2>/dev/null
        echo "Unset alias '${alias}'."
    else
        echo "Error: Alias '${alias}' not found." >&2
        return 1
    fi
}

__nav_list() {
    if [ -s "$NAV_ALIASES_FILE" ]; then
        echo "Defined Aliases:"
        local alias path disp suffix
        while IFS='=' read -r alias path; do
            [ -z "$alias" ] && continue
            disp=$(__nav_display_path "$path")
            suffix=""
            [ ! -d "$path" ] && suffix="  [missing]"
            printf '%s=%s%s\n' "$alias" "$disp" "$suffix"
        done < "$NAV_ALIASES_FILE" | column -t -s '='
    else
        echo "No aliases defined yet."
    fi
}

__nav_prune() {
    __nav_ensure_aliases

    local yes=0
    case "$1" in
        -y|--yes) yes=1 ;;
    esac

    local broken=() alias path
    while IFS='=' read -r alias path; do
        [ -z "$alias" ] && continue
        [ ! -d "$path" ] && broken+=("${alias}=${path}")
    done < "$NAV_ALIASES_FILE"

    if [ ${#broken[@]} -eq 0 ]; then
        echo "No broken aliases found."
        return 0
    fi

    echo "Broken aliases (path no longer exists):"
    local b
    for b in "${broken[@]}"; do
        echo "  ${b%%=*} -> ${b#*=}"
    done

    if [ "$yes" -ne 1 ]; then
        printf "Remove %d broken alias(es)? [y/N] " "${#broken[@]}"
        local ans=""
        read -r ans
        case "$ans" in
            y|Y|yes|YES) ;;
            *)
                echo "Cancelled." >&2
                return 1
                ;;
        esac
    fi

    for b in "${broken[@]}"; do
        local a="${b%%=*}"
        sed -i "/^${a}=/d" "$NAV_ALIASES_FILE"
        sed -i "/^${a}=/d" "$NAV_USAGE_FILE" 2>/dev/null
    done
    echo "Removed ${#broken[@]} broken alias(es)."
}

__nav_export() {
    local filename="navm_export_$(date +%Y-%m-%d).conf"

    if [ "$1" == "--name" ] && [ -n "$2" ]; then
        filename="$2"
    fi

    cp "$NAV_ALIASES_FILE" "$filename"
    echo "Configuration exported to '$(pwd)/${filename}'."
}

__nav_import() {
    if [ -z "$1" ] || [ ! -f "$1" ]; then
        echo "Usage: nav import <path/to/file>" >&2
        echo "Error: File not found." >&2
        return 1
    fi

    local import_file="$1"
    local imported_count=0

    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || "$line" == \#* ]] && continue

        local alias=$(echo "$line" | cut -d'=' -f1)
        local path=$(echo "$line" | cut -d'=' -f2-)

        if [ -n "$alias" ] && [ -n "$path" ]; then
            if grep -q "^${alias}=" "$NAV_ALIASES_FILE"; then
                sed -i "s|^${alias}=.*|${alias}=${path}|" "$NAV_ALIASES_FILE"
            else
                echo "${alias}=${path}" >> "$NAV_ALIASES_FILE"
            fi
            imported_count=$((imported_count + 1))
        fi
    done < "$import_file"

    echo "Import complete. ${imported_count} aliases processed."
}

# ─── Interactive mode ──────────────────────────────────────────────────────────
#
# Fuzzy-picker-style UI for selecting a path without remembering its name.
# Navigate with the arrow keys or vim's j/k (h/l for paging), type to filter,
# Enter to act on the selection (cd / open / print, depending on how it was
# launched), Ctrl-D to delete the highlighted entry, Esc/Ctrl-C to quit.
#
# j/k/h/l double as both navigation and letters, so they're only treated as
# navigation while `editing` is 0 (search box empty and untouched). Typing
# any other character flips `editing` to 1, after which j/k/h/l are typed
# literally into the search box instead — so searching for "jira" or "logs"
# still works, it just takes one extra keystroke to "arm" the box. Press
# `/` (vim-style) to arm it explicitly without typing a character, for when
# the very first letter you want to search happens to be j/k/h/l. Arrow
# keys always navigate, in every state, since they never collide with typed
# text. Backspacing the query back to empty disarms `editing` again.
#
# Search matches the full "label=path" line as a plain substring, and also
# matches the label alone with fuzzy (out-of-order) matching — so typing
# "agw" finds "api-gateway" even though it's not a literal substring. Fuzzy
# matching is deliberately scoped to the (short) label only: doing it
# against full paths too would match almost anything and defeat the point
# of filtering.
#
# What populates the list depends on $source_mode:
#   smart   - your defined aliases (nav set), pre-sorted by frecency. With
#             an empty search box it shows only the ones you've actually
#             used (so the common case is a short, relevant list); the
#             moment you type anything it searches *all* of them, so a
#             brand-new alias you haven't visited yet is never truly
#             hidden. This is what bare `nav`/`-o`/`-p`/`o`/`p` use.
#   all     - same alias data, but always shows everything, used or not.
#             This is what `nav i`/`interactive` uses.
#   learned - not aliases at all: the auto-tracked `cd` history from
#             ~/.navm_frecent (see the "Directory learning" section above).
#             This is what `nav f`/`frequent` uses — it "learns" paths you
#             actually visit, no `nav set` required.
#
# The functions below share state (entries/used_entries/filtered/query/sel/
# editing/page_size/action/open_override/source_mode/status_msg) through
# bash's dynamic scoping: they're only ever called while those `local`
# variables are in scope inside __nav_interactive.

__nav_ia_fuzzy() {
    # Subsequence match: every char of $2 appears in $1, in order.
    local hay="$1" needle="$2"
    local hi=0 ni=0 hlen=${#hay} nlen=${#needle}
    while [ "$hi" -lt "$hlen" ] && [ "$ni" -lt "$nlen" ]; do
        [ "${hay:$hi:1}" = "${needle:$ni:1}" ] && ni=$((ni + 1))
        hi=$((hi + 1))
    done
    [ "$ni" -eq "$nlen" ]
}

__nav_ia_filter() {
    local base=()
    if [ -z "$query" ] && [ ${#used_entries[@]} -gt 0 ]; then
        base=("${used_entries[@]}")
    else
        base=("${entries[@]}")
    fi

    filtered=()
    if [ -z "$query" ]; then
        filtered=("${base[@]}")
    else
        local q="${query,,}" e le label label_lc
        for e in "${base[@]}"; do
            le="${e,,}"
            label="${e%%=*}"
            label_lc="${label,,}"
            if [[ "$le" == *"$q"* ]] || __nav_ia_fuzzy "$label_lc" "$q"; then
                filtered+=("$e")
            fi
        done
    fi

    local count=${#filtered[@]}
    if [ "$count" -eq 0 ]; then
        sel=0
    elif [ "$sel" -ge "$count" ]; then
        sel=$((count - 1))
    fi
}

__nav_ia_move() {
    local count=${#filtered[@]}
    [ "$count" -eq 0 ] && return
    sel=$((sel + $1))
    if [ "$sel" -lt 0 ]; then
        sel=$((count - 1))
    elif [ "$sel" -ge "$count" ]; then
        sel=0
    fi
}

__nav_ia_page() {
    local count=${#filtered[@]}
    [ "$count" -eq 0 ] && return
    sel=$((sel + $1 * page_size))
    if [ "$sel" -lt 0 ]; then
        sel=0
    elif [ "$sel" -gt $((count - 1)) ]; then
        sel=$((count - 1))
    fi
}

__nav_ia_delete_selected() {
    [ ${#filtered[@]} -eq 0 ] && return

    local sel_entry="${filtered[$sel]}"
    local sel_label="${sel_entry%%=*}"
    local sel_path="${sel_entry#*=}"

    if [ "$source_mode" = "learned" ]; then
        __nav_untrack_path "$sel_path"
        status_msg="Removed learned path '$(__nav_display_path "$sel_path")'."
    else
        sed -i "/^${sel_label}=/d" "$NAV_ALIASES_FILE" 2>/dev/null
        sed -i "/^${sel_label}=/d" "$NAV_USAGE_FILE" 2>/dev/null
        status_msg="Deleted alias '${sel_label}'."
    fi

    local kept=() e
    for e in "${entries[@]}"; do
        [ "${e#*=}" != "$sel_path" ] && kept+=("$e")
    done
    entries=("${kept[@]}")

    kept=()
    for e in "${used_entries[@]}"; do
        [ "${e#*=}" != "$sel_path" ] && kept+=("$e")
    done
    used_entries=("${kept[@]}")

    __nav_ia_filter
    __nav_ia_render
    sleep 0.6
    status_msg=""
}

__nav_ia_render() {
    local count=${#filtered[@]}
    local cols
    cols=$(tput cols 2>/dev/null)
    cols=${cols:-80}

    local total_pages=$(( (count + page_size - 1) / page_size ))
    [ "$total_pages" -lt 1 ] && total_pages=1

    local page=0
    [ "$page_size" -gt 0 ] && page=$((sel / page_size))

    local start=$((page * page_size))
    local end=$((start + page_size - 1))
    [ "$end" -gt $((count - 1)) ] && end=$((count - 1))

    local showing_subset=0
    [ -z "$query" ] && [ ${#used_entries[@]} -gt 0 ] && [ ${#used_entries[@]} -lt ${#entries[@]} ] && showing_subset=1

    local hint="(type to search, / to force)"
    if [ "$editing" = 1 ]; then
        hint="(editing — j/k/h/l typed literally)"
    elif [ "$showing_subset" = 1 ]; then
        hint="(most used — type to search everything)"
    fi

    local mode_label="interactive"
    case "$source_mode" in
        all)     mode_label="interactive (all)" ;;
        learned) mode_label="frequent (auto-tracked)" ;;
    esac
    local enter_label="select"
    case "$action" in
        open)  mode_label="${mode_label} — open mode";  enter_label="open" ;;
        print) mode_label="${mode_label} — print mode"; enter_label="print" ;;
    esac

    printf '\033[H\033[J'
    printf '  \033[1mnav\033[0m \033[2m— %s (%d total, %d shown)\033[0m\n\n' "$mode_label" "${#entries[@]}" "$count"
    printf '  Search: %s\033[7m \033[0m  \033[2m%s\033[0m\n' "$query" "$hint"
    [ -n "$status_msg" ] && printf '  \033[33m%s\033[0m\n' "$status_msg"
    printf '\n'

    if [ "$count" -eq 0 ]; then
        printf '    No matches.\n'
    else
        local i entry label epath disp line missing maxw=$((cols - 8))
        [ "$maxw" -lt 10 ] && maxw=10
        for (( i = start; i <= end; i++ )); do
            entry="${filtered[$i]}"
            label="${entry%%=*}"
            epath="${entry#*=}"
            disp=$(__nav_display_path "$epath")
            missing=0
            [ ! -d "$epath" ] && missing=1

            line=$(printf '%-16s %s' "$label" "$disp")
            [ "$missing" = 1 ] && line="${line}  [missing]"
            if [ "${#line}" -gt "$maxw" ]; then
                line="${line:0:$((maxw - 1))}…"
            fi

            if [ "$i" -eq "$sel" ]; then
                printf '  \033[7m› %s\033[0m\n' "$line"
            elif [ "$missing" = 1 ]; then
                printf '    \033[31m%s\033[0m\n' "$line"
            else
                printf '    %s\n' "$line"
            fi
        done
    fi

    printf '\n  Page %d/%d   \033[2m↑/↓ move · ←/→ page · Enter %s · Ctrl-D delete · Esc/Ctrl-C quit\033[0m\n' "$((page + 1))" "$total_pages" "$enter_label"
}

__nav_interactive() {
    # $1: action on Enter — "cd" (default), "open", or "print".
    # $2: opener override, only used when $1 is "open" (same as `nav <alias> -o [program]`).
    # $3: source_mode — "smart" (default), "all", or "learned". See the
    #     block comment above this section for what each one shows.
    local action="${1:-cd}" open_override="$2" source_mode="${3:-smart}"

    if [ ! -t 0 ] || [ ! -t 1 ]; then
        echo "Error: interactive mode requires a terminal." >&2
        return 1
    fi

    __nav_ensure_aliases
    __nav_ensure_config
    __nav_ensure_usage
    __nav_ensure_frecent

    local entries=() used_entries=()

    if [ "$source_mode" = "learned" ]; then
        local sort_input="" cnt epoch p
        while IFS=$'\t' read -r cnt epoch p; do
            [ -z "$p" ] && continue
            sort_input+="${cnt}"$'\t'"${epoch}"$'\t'"${p}"$'\n'
        done < "$NAV_FRECENT_FILE"

        local sorted=()
        while IFS=$'\t' read -r cnt epoch p; do
            [ -z "$p" ] && continue
            sorted+=("$(basename "$p")=$p")
        done < <(printf '%s' "$sort_input" | sort -t $'\t' -k1,1nr -k2,2nr)

        entries=("${sorted[@]}")
        used_entries=("${entries[@]}")

        if [ ${#entries[@]} -eq 0 ]; then
            echo "No learned paths yet (directory tracking is '$(__nav_config_get_track)')."
            echo "Just keep using 'cd' — nav learns as you go. Toggle with 'nav config track <on|off>'."
            return 0
        fi
    else
        local raw=()
        while IFS= read -r line; do
            [ -z "$line" ] && continue
            raw+=("$line")
        done < "$NAV_ALIASES_FILE"

        if [ ${#raw[@]} -eq 0 ]; then
            echo "No aliases defined yet. Use 'nav set [--alias <name>]' to create one."
            return 0
        fi

        # Sort by frecency (usage count desc, then last-used desc).
        local sort_input="" e a cnt epoch up
        for e in "${raw[@]}"; do
            a="${e%%=*}"
            up=$(__nav_usage_get "$a")
            cnt="${up%%:*}"
            epoch="${up##*:}"
            sort_input+="${cnt}"$'\t'"${epoch}"$'\t'"${e}"$'\n'
        done

        local sorted=() used=()
        while IFS=$'\t' read -r cnt epoch e; do
            [ -z "$e" ] && continue
            sorted+=("$e")
            [ "$cnt" -gt 0 ] && used+=("$e")
        done < <(printf '%s' "$sort_input" | sort -t $'\t' -k1,1nr -k2,2nr)

        entries=("${sorted[@]}")
        # "all" mode never restricts to the used-only subset; "smart" does,
        # via __nav_ia_filter (which itself falls back to the full list
        # whenever used_entries is empty — e.g. brand new setup).
        if [ "$source_mode" = "all" ]; then
            used_entries=("${entries[@]}")
        else
            used_entries=("${used[@]}")
        fi
    fi

    local page_size
    page_size=$(__nav_config_get_page_size)

    local query="" sel=0 editing=0 status_msg=""
    local filtered=()
    __nav_ia_filter

    local old_stty=""
    old_stty=$(stty -g 2>/dev/null)

    __nav_ia_cleanup() {
        [ -n "$old_stty" ] && stty "$old_stty" 2>/dev/null
        tput cnorm 2>/dev/null
        printf '\033[H\033[J'
    }

    trap '__nav_ia_cleanup; trap - RETURN INT' RETURN INT
    stty -echo -icanon min 1 time 0 2>/dev/null
    tput civis 2>/dev/null

    local result_path="" result_label=""
    while true; do
        __nav_ia_render

        local key="" k2="" k3=""
        IFS= read -rsn1 key || break

        if [ "$key" = $'\x1b' ]; then
            IFS= read -rsn1 -t 0.05 k2
            if [ "$k2" = '[' ]; then
                IFS= read -rsn1 -t 0.05 k3
                case "$k3" in
                    A) __nav_ia_move -1 ;;
                    B) __nav_ia_move 1 ;;
                    D) __nav_ia_page -1 ;;
                    C) __nav_ia_page 1 ;;
                esac
            elif [ -n "$query" ]; then
                query=""
                editing=0
                __nav_ia_filter
            else
                break
            fi
        elif [ -z "$key" ]; then
            # Enter
            if [ ${#filtered[@]} -gt 0 ]; then
                result_label="${filtered[$sel]%%=*}"
                result_path="${filtered[$sel]#*=}"
            fi
            break
        elif [ "$key" = $'\x7f' ] || [ "$key" = $'\x08' ]; then
            if [ -n "$query" ]; then
                query="${query%?}"
                [ -z "$query" ] && editing=0
                __nav_ia_filter
            fi
        elif [ "$key" = $'\x03' ]; then
            break
        elif [ "$key" = $'\x04' ]; then
            __nav_ia_delete_selected
            [ ${#entries[@]} -eq 0 ] && break
        elif [ "$key" = '/' ] && [ "$editing" = 0 ]; then
            # Explicit "start typing" — arms the search box without
            # inserting a character, for terms starting with j/k/h/l.
            editing=1
        else
            case "$key" in
                j) if [ "$editing" = 0 ]; then __nav_ia_move 1; else query+="$key"; __nav_ia_filter; fi ;;
                k) if [ "$editing" = 0 ]; then __nav_ia_move -1; else query+="$key"; __nav_ia_filter; fi ;;
                h) if [ "$editing" = 0 ]; then __nav_ia_page -1; else query+="$key"; __nav_ia_filter; fi ;;
                l) if [ "$editing" = 0 ]; then __nav_ia_page 1; else query+="$key"; __nav_ia_filter; fi ;;
                *) editing=1; query+="$key"; __nav_ia_filter ;;
            esac
        fi
    done

    __nav_ia_cleanup
    trap - RETURN INT 2>/dev/null

    if [ -n "$result_path" ]; then
        if [ -d "$result_path" ]; then
            case "$action" in
                open)
                    __nav_open "$result_path" "$open_override"
                    __nav_track_path "$result_path"
                    [ "$source_mode" != "learned" ] && __nav_track_usage "$result_label"
                    ;;
                print)
                    printf '%s\n' "$result_path"
                    ;;
                *)
                    cd "$result_path" || return 1
                    [ "$source_mode" != "learned" ] && __nav_track_usage "$result_label"
                    ;;
            esac
        else
            echo "Error: path '${result_path}' no longer exists." >&2
            return 1
        fi
    fi
}

__nav_interactive_dispatch() {
    # Parses an optional trailing -o [program] / -p after a mode subcommand
    # (nav i, nav interactive, nav f, nav frequent) into an __nav_interactive call.
    local source_mode="$1"
    shift
    local action="cd" override=""
    case "$1" in
        -o) action="open"; override="$2" ;;
        -p) action="print" ;;
    esac
    __nav_interactive "$action" "$override" "$source_mode"
}

# ─── cd hook (feeds "nav f"'s learned paths) ───────────────────────────────────
#
# Wraps the `cd` builtin so every successful directory change — via a nav
# alias, `nav f` itself, or a plain hand-typed `cd` — is logged for `nav f`.
# Disable with `nav config track off` if you'd rather it not touch `cd` at
# all (the wrapper stays installed either way, it just becomes a no-op
# passthrough). If you already have your own `cd` function, whichever one
# is sourced *last* in your shell startup wins — reorder your `source`
# lines if you want both.

cd() {
    builtin cd "$@"
    local rc=$?
    if [ $rc -eq 0 ] && [ "$(__nav_config_get_track)" = "on" ]; then
        __nav_track_path "$PWD"
    fi
    return $rc
}

# ─── Navigation ───────────────────────────────────────────────────────────────

__nav_goto() {
    local alias="$1"
    shift

    local path
    path=$(__nav_resolve_alias "$alias")

    if [ -z "$path" ]; then
        echo "Error: Alias '${alias}' not found." >&2
        __nav_help
        return 1
    fi

    if [ ! -d "$path" ]; then
        echo "Error: The path for '${alias}' ('${path}') no longer exists." >&2
        return 1
    fi

    case "$1" in
        -o)
            shift
            __nav_open "$path" "$1"
            local rc=$?
            __nav_track_usage "$alias"
            __nav_track_path "$path"
            return $rc
            ;;
        -p)
            # Print the path instead of cd'ing — e.g. `cd "$(nav proj -p)"`.
            # Not tracked as a "visit": it's meant for scripting/lookups.
            printf '%s\n' "$path"
            ;;
        -x)
            shift
            if [ $# -eq 0 ]; then
                echo "Usage: nav <alias> -x <command> [args...]" >&2
                return 1
            fi
            ( cd "$path" && "$@" )
            local rc=$?
            __nav_track_usage "$alias"
            return $rc
            ;;
        "")
            cd "$path" || return 1
            __nav_track_usage "$alias"
            ;;
        *)
            echo "Usage: nav <alias> [-o [program] | -p | -x <command> [args...]]" >&2
            return 1
            ;;
    esac
}

