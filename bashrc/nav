#!/bin/bash
# nav - A simple navigation manager
# Oriented to functions

NAV_CONFIG_FILE="$HOME/.navm_aliases"

__nav_ensure_config() {
    touch "$NAV_CONFIG_FILE"
}

__nav_resolve_alias() {
    local alias="$1"
    grep "^${alias}=" "$NAV_CONFIG_FILE" | cut -d'=' -f2-
}

__nav_set() {
    local alias=""
    local path=""

    if [ "$1" == "--alias" ] && [ -n "$2" ]; then
        alias="$2"
    else
        echo "Usage: nav set --alias <alias_name> [--path <directory_path>]" >&2
        return 1
    fi

    if [ "$3" == "--path" ] && [ -n "$4" ]; then
        path=$(realpath "$4")
    elif [ -z "$3" ]; then
        path=$(pwd)
    else
        echo "Usage: nav set --alias <alias_name> [--path <directory_path>]" >&2
        return 1
    fi

    if [ ! -d "$path" ]; then
        echo "Error: Path '$path' does not exist or is not a directory." >&2
        return 1
    fi

    if grep -q "^${alias}=" "$NAV_CONFIG_FILE"; then
        sed -i "s|^${alias}=.*|${alias}=${path}|" "$NAV_CONFIG_FILE"
        echo "Updated alias '${alias}' to '${path}'."
    else
        echo "${alias}=${path}" >> "$NAV_CONFIG_FILE"
        echo "Set alias '${alias}' to '${path}'."
    fi
}

__nav_unset() {
    if [ -z "$1" ]; then
        echo "Usage: nav unset <alias_name>" >&2
        return 1
    fi

    local alias="$1"

    if grep -q "^${alias}=" "$NAV_CONFIG_FILE"; then
        sed -i "/^${alias}=/d" "$NAV_CONFIG_FILE"
        echo "Unset alias '${alias}'."
    else
        echo "Error: Alias '${alias}' not found." >&2
        return 1
    fi
}

__nav_list() {
    if [ -s "$NAV_CONFIG_FILE" ]; then
        echo "Defined Aliases:"
        column -t -s '=' "$NAV_CONFIG_FILE"
    else
        echo "No aliases defined yet."
    fi
}

__nav_export() {
    local filename="navm_export_$(date +%Y-%m-%d).conf"

    if [ "$1" == "--name" ] && [ -n "$2" ]; then
        filename="$2"
    fi

    cp "$NAV_CONFIG_FILE" "$filename"
    echo "Configuration exported to '$(pwd)/${filename}'."
}

__nav_import() {
    if [ -z "$1" ] || [ ! -f "$1" ]; then
        echo "Usage: nav import <path/to/file>" >&2
        echo "Error: File not found." >&2
        return 1
    fi

    local import_file="$1"
    local imported_count=0

    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || "$line" == \#* ]] && continue

        local alias=$(echo "$line" | cut -d'=' -f1)
        local path=$(echo "$line" | cut -d'=' -f2-)

        if [ -n "$alias" ] && [ -n "$path" ]; then
            if grep -q "^${alias}=" "$NAV_CONFIG_FILE"; then
                sed -i "s|^${alias}=.*|${alias}=${path}|" "$NAV_CONFIG_FILE"
            else
                echo "${alias}=${path}" >> "$NAV_CONFIG_FILE"
            fi
            imported_count=$((imported_count + 1))
        fi
    done < "$import_file"

    echo "Import complete. ${imported_count} aliases processed."
}

__nav_open() {
    local path="$1"
    local opener="explorer.exe"

    if [ -n "$2" ]; then
        opener="$2"
    fi

    local win_path=$(wslpath -w "$path")
    "$opener" "$win_path"
}

__nav_goto() {
    local alias="$1"
    local path=$(__nav_resolve_alias "$alias")

    if [ -z "$path" ]; then
        echo "Error: Alias '${alias}' not found." >&2
        __nav_help
        return 1
    fi

    if [ ! -d "$path" ]; then
        echo "Error: The path for '${alias}' ('${path}') no longer exists." >&2
        return 1
    fi

    if [ "$2" == "-o" ]; then
        __nav_open "$path" "$3"
    else
        cd "$path"
    fi
}

__nav_help() {
    echo ""
    echo "   ███╗   ██╗  █████╗  ██╗   ██╗"
    echo "   ████╗  ██║ ██╔══██╗ ██║   ██║"
    echo "   ██╔██╗ ██║ ███████║ ██║   ██║"
    echo "   ██║╚██╗██║ ██╔══██║ ╚██╗ ██╔╝"
    echo "   ██║ ╚████║ ██║  ██║  ╚████╔╝ "
    echo "   ╚═╝  ╚═══╝ ╚═╝  ╚═╝   ╚═══╝ "
    echo ""
    echo "  nav: A simple navigation manager"
    echo "  -----------------------------------"
    echo "  Usage: nav <command> [options]"
    echo ""
    echo "  Commands:"
    echo "    nav <alias>                     Navigate to the path defined by the alias."
    echo "    nav <alias> -o [program]        Open alias path in a program (default: explorer.exe)."
    echo "    nav set --alias a [--path p]    Set or update an alias 'a' to a path 'p'."
    echo "    nav unset <alias>               Remove an alias."
    echo "    nav list                        List all defined aliases."
    echo "    nav import <file>               Import aliases from a text file."
    echo "    nav export [--name file]        Export aliases to a file (default: navm_export_DATE.conf)."
    echo "    nav help                        Show this help message."
}

nav() {
    __nav_ensure_config

    if [[ $# -eq 0 ]]; then
        __nav_help
        return 0
    fi

    case "$1" in
        set)      shift; __nav_set "$@" ;;
        unset)    shift; __nav_unset "$@" ;;
        list)     __nav_list ;;
        export)   shift; __nav_export "$@" ;;
        import)   shift; __nav_import "$@" ;;
        help|--help|-h) __nav_help ;;
        *)        __nav_goto "$@" ;;
    esac
}
